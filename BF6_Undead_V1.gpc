//=============================================== 
//                 ASC_PRO_MOD                    
//=============================================== 
combo ASC { // Professional Slide Cancel.         
    wait(14); // If this becomes an issue, change it to 12 or 15. Worked fine here.
    set_val(XB1_B, 100);                                          
    wait(14); // If this becomes and issue, change to anything between 11-20. 
    set_val(XB1_B, 100);          
    set_val(XB1_A, 100);          
    wait(12);                                     
    set_val(XB1_B, 0);            
    set_val(XB1_A, 100);         
    wait(12);                                      
    set_val(XB1_A, 0);             
}                                                   
//===============================================  
//                 ESC                             
//===============================================  
combo ASCE { //--- Easy Slide Cancel.              
    set_val(XB1_B, 100);          
    wait(380);                         
    set_val(XB1_B, 0);            
    wait(60);                          
    set_val(XB1_B, 100);          
    wait(50);                          
    set_val(XB1_B, 100);          
    set_val(XB1_A, 100);           
    wait(60);                          
    set_val(XB1_B, 0);            
    set_val(XB1_A, 100);          
    wait(10);                        
    set_val(XB1_A, 0);         
}                             
