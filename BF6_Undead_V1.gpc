/////////////////////////////////////////////////////////////////////////////  
///   INITIALIZATION BLOCK                                                      
/////////////////////////////////////////////////////////////////////////////   
init {  
quick_scope_onoff         = get_pvar(SPVAR_1,0,1,0); 
ToggleBattsStickyAim      = get_pvar(SPVAR_2,0,1,0); 
steady_aim_onoff          = get_pvar(SPVAR_3,0,1,0); 
sweet_evil_onoff          = get_pvar(SPVAR_4,0,1,0); 
recoil_profiles_onoff     = get_pvar(SPVAR_5,0,1,0); 
VM_Speed                  = get_pvar(SPVAR_6,1,5,0); 
USE_HAIR_TRIGGER          = get_pvar(SPVAR_7,0,1,0); 
rumble_onoff              = get_pvar(SPVAR_8,0,1,0); 
j_calibration_onoff       = get_pvar(SPVAR_9,0,1,0); 
HeadShotAssist_onoff      = get_pvar(SPVAR_10,0,1,0); 
easy_revive_onoff         = get_pvar(SPVAR_11,0,1,0); 
AutoSlideCancelEasy_onoff = get_pvar(SPVAR_12,0,1,0); 
AutoSlideCancel_onoff     = get_pvar(SPVAR_13,0,1,0); 
scopeshot_onoff           = get_pvar(SPVAR_14,0,1,0); 
sniper_onoff              = get_pvar(SPVAR_15,0,1,0); 
akimbo_onoff              = get_pvar(SPVAR_16,0,1,0); 
auto_jump_onoff           = get_pvar(SPVAR_17,0,1,0); 
jumpshot_onoff            = get_pvar(SPVAR_18,1,4,0); 
ToggleStrafeShot          = get_pvar(SPVAR_19,1,4,0); 
dropshot_onoff            = get_pvar(SPVAR_20,1,4,0); 
holdbreath_onoff          = get_pvar(SPVAR_21,1,2,0); 
BUTTON_LAYOUT             = get_pvar(SPVAR_22,1,27,0); 
STICK_LAYOUT              = get_pvar(SPVAR_23,1,5,0); 
smart_fire_onoff          = get_pvar(SPVAR_24,1,3,0); 
rapidfire_onoff           = get_pvar(SPVAR_25,1,3,0); 
quick_scope_val        = get_pvar(SPVAR_26, 50,600, 350);
AimAssistTime         = get_pvar(SPVAR_27, 1,100, 20);
AimAssistSize         = get_pvar(SPVAR_28, 1,100, 15);
STEADY_AIM             = get_pvar(SPVAR_29, 2,90, 15);
 STEADY_AIM = (360 / STEADY_AIM) / 2; 
Aim_Boost              = get_pvar(SPVAR_30, 1,30, 7);
Aim_Correction         = get_pvar(SPVAR_31, 1,30, 12);
VRecoil_1              = get_pvar(SPVAR_32, 1,100, 20);
HRecoil_1              = get_pvar(SPVAR_33,-99,99, 0);
VRecoil_2              = get_pvar(SPVAR_34, 1,99, 25);
HRecoil_2              = get_pvar(SPVAR_35,-99,99, 0);
VRecoil_3              = get_pvar(SPVAR_36, 1,99, 30);
HRecoil_3              = get_pvar(SPVAR_37,-99,99, 0);
HeadShotStrength       = get_pvar(SPVAR_38, 1,99, 20);
HeadShotHoldTime       = get_pvar(SPVAR_39, 1,2000, 800);
revive_time            = get_pvar(SPVAR_40, 500,20000, 10000);
sniper_hold            = get_pvar(SPVAR_41, 100,6000, 3000);
auto_jump_val          = get_pvar(SPVAR_42, 10,2000, 200);
StrafeShotTime         = get_pvar(SPVAR_43, 1,999, 400);
drop_shot_hold        = get_pvar(SPVAR_44, 100,6000, 600);
drop_shot_rest        = get_pvar(SPVAR_45, 100,6000, 5000);
smartF_hold           = get_pvar(SPVAR_46, 30, 60, 40);
smartF_rest           = get_pvar(SPVAR_47, 100, 800, 350);
RF_hold               = get_pvar(SPVAR_48, 1,1000, 20);
RF_release            = get_pvar(SPVAR_49, 1,1000, 30);
  STICK_X_j_cal = PS4_LX;  STICK_X_j_cal[1] = 11; 
  STICK_Y_j_cal = PS4_LY; STICK_Y_j_cal[1] = 12; 
  StickDZ = dk_max(abs(get_ival(PS4_RX)), abs(get_ival(PS4_RY))) + 5;
  StickDZ[1]  = dk_max(abs(get_ival(PS4_LX)), abs(get_ival(PS4_LY))) + 5;

}// end of init block
///////////////////////////////////////////////////////////////////////////// 
///   MAIN BLOCK                                                             
/////////////////////////////////////////////////////////////////////////////
main {//---------------------------------
                                  
   /////////////////////////////////////////
    Run_Button_Configs();
 if(get_ival(XB1_LT)){
     if(event_press(PS4_SHARE)){
         EntireScript_OnOff    = !EntireScript_OnOff;
         blinck(EntireScript_OnOff);
         cls_oled(0);
         draw_rectangle();
         //display_mod(f_idx, f_string, mod_name, f_toggle, f_option)
         display_mod( center_x(sizeof(SCRIPT_ONOFF)- 1, OLED_FONT_MEDIUM_WIDTH) ,SCRIPT_ONOFF [0],EntireScript_OnOff ,1);
         show_mesage_time = 2000;
 		 //--- Set Virtual Machine Speed to Default if script is OFF    
 		 if(!EntireScript_OnOff) set_Virtual_Machine_Speed(VM_Default); 
     }
 }
                          
 if(show_mesage_time){
     show_mesage_time -= get_rtime();
     if(show_mesage_time <= 0) {
         cls_oled(0);    
     }
 }
                               
//============================================================
// KILL SWITCH FOR ENTIRE SCRIPT
//============================================================
 if(EntireScript_OnOff){
  //--- Set Virtual Machine Speed to Default for MENU                     
	if(ModEdit || ModMenu) set_Virtual_Machine_Speed(VM_Default);
    if(display_EDIT){                
    	  // Clear OLED screen         
        cls_oled(0);                        
       // display_edit(f_idx, f_string, f_print, f_val) 
		if(EditVal[ modName_idx ] == 0 ){  
			  //--- print label                
		    line_oled(1,45,127,45,1,0);    
		    print( center_x( 17, OLED_FONT_SMALL_WIDTH ), 20, OLED_FONT_SMALL, 1, NO_EDIT_VAR1[0] ); 
		    print( center_x( 12, OLED_FONT_SMALL_WIDTH ), 33, OLED_FONT_SMALL, 1, NO_EDIT_VAR2[0] ); 
		}                                                                                            
		else {//----  ELSE BEGIN --------------  
          display_edit( adjust_variable_idx [adjust_variable_idx + 1]);
          adjust_variable_idx [adjust_variable_idx + 1] = edit_val(adjust_variable_idx [adjust_variable_idx + 1] );
		}//--- ELSE END   ----------- 
   }//  end of display edit  
    if(refresh_OLED)
    { 
        // Clear OLED screen 
        cls_oled(0);       
                           
        // Draw Rectangle 
        draw_rectangle(); 
        // Display Mod Name and togle status  : ON/OFF   
        if(modName_idx == 0)display_mod( center_x(sizeof(QUICKSCOPE)- 1, OLED_FONT_MEDIUM_WIDTH) ,QUICKSCOPE[0],quick_scope_onoff,Options[ modName_idx ]);
        if(modName_idx == 1)display_mod( center_x(sizeof(BATTSSTICKYAIM)- 1, OLED_FONT_MEDIUM_WIDTH) ,BATTSSTICKYAIM[0],ToggleBattsStickyAim,Options[ modName_idx ]);
        if(modName_idx == 2)display_mod( center_x(sizeof(STEADYAIM)- 1, OLED_FONT_MEDIUM_WIDTH) ,STEADYAIM[0],steady_aim_onoff,Options[ modName_idx ]);
        if(modName_idx == 3)display_mod( center_x(sizeof(AIMASSISTSWEET)- 1, OLED_FONT_MEDIUM_WIDTH) ,AIMASSISTSWEET[0],sweet_evil_onoff,Options[ modName_idx ]);
        if(modName_idx == 4)display_mod( center_x(sizeof(ANTIRECOIL3Profiles)- 1, OLED_FONT_MEDIUM_WIDTH) ,ANTIRECOIL3Profiles[0],recoil_profiles_onoff,Options[ modName_idx ]);
        if(modName_idx == 5)display_mod( center_x(sizeof(VMSPEED)- 1, OLED_FONT_MEDIUM_WIDTH) ,VMSPEED[0],VM_Speed,Options[ modName_idx ]);
        if(modName_idx == 6)display_mod( center_x(sizeof(HAIRTRIGGERS)- 1, OLED_FONT_MEDIUM_WIDTH) ,HAIRTRIGGERS[0],USE_HAIR_TRIGGER,Options[ modName_idx ]);
        if(modName_idx == 7)display_mod( center_x(sizeof(RUMBLESONOFF)- 1, OLED_FONT_MEDIUM_WIDTH) ,RUMBLESONOFF[0],rumble_onoff,Options[ modName_idx ]);
        if(modName_idx == 8)display_mod( center_x(sizeof(JOYSTICKCALIBRATION)- 1, OLED_FONT_MEDIUM_WIDTH) ,JOYSTICKCALIBRATION[0],j_calibration_onoff,Options[ modName_idx ]);
        if(modName_idx == 9)display_mod( center_x(sizeof(HEAD_SHOT_ASSIST)- 1, OLED_FONT_MEDIUM_WIDTH) ,HEAD_SHOT_ASSIST[0],HeadShotAssist_onoff,Options[ modName_idx ]);
        if(modName_idx == 10)display_mod( center_x(sizeof(EASY_REVIVE_MOD)- 1, OLED_FONT_MEDIUM_WIDTH) ,EASY_REVIVE_MOD[0],easy_revive_onoff,Options[ modName_idx ]);
        if(modName_idx == 11)display_mod( center_x(sizeof(AUTOSLIDEEASY)- 1, OLED_FONT_MEDIUM_WIDTH) ,AUTOSLIDEEASY[0],AutoSlideCancelEasy_onoff,Options[ modName_idx ]);
        if(modName_idx == 12)display_mod( center_x(sizeof(AUTOSLIDE)- 1, OLED_FONT_MEDIUM_WIDTH) ,AUTOSLIDE[0],AutoSlideCancel_onoff,Options[ modName_idx ]);
        if(modName_idx == 13)display_mod( center_x(sizeof(SCOPESHOT)- 1, OLED_FONT_MEDIUM_WIDTH) ,SCOPESHOT[0],scopeshot_onoff,Options[ modName_idx ]);
        if(modName_idx == 14)display_mod( center_x(sizeof(SNIPER)- 1, OLED_FONT_MEDIUM_WIDTH) ,SNIPER[0],sniper_onoff,Options[ modName_idx ]);
        if(modName_idx == 15)display_mod( center_x(sizeof(AKIMBOFIRE)- 1, OLED_FONT_MEDIUM_WIDTH) ,AKIMBOFIRE[0],akimbo_onoff,Options[ modName_idx ]);
        if(modName_idx == 16)display_mod( center_x(sizeof(AUTOJUMP)- 1, OLED_FONT_MEDIUM_WIDTH) ,AUTOJUMP[0],auto_jump_onoff,Options[ modName_idx ]);
        if(modName_idx == 17)display_mod( center_x(sizeof(JUMPSHOT)- 1, OLED_FONT_MEDIUM_WIDTH) ,JUMPSHOT[0],jumpshot_onoff,Options[ modName_idx ]);
        if(modName_idx == 18)display_mod( center_x(sizeof(STRAFESHOT)- 1, OLED_FONT_MEDIUM_WIDTH) ,STRAFESHOT[0],ToggleStrafeShot,Options[ modName_idx ]);
        if(modName_idx == 19)display_mod( center_x(sizeof(DROPSHOT)- 1, OLED_FONT_MEDIUM_WIDTH) ,DROPSHOT[0],dropshot_onoff,Options[ modName_idx ]);
        if(modName_idx == 20)display_mod( center_x(sizeof(HOLDBREATH)- 1, OLED_FONT_MEDIUM_WIDTH) ,HOLDBREATH[0],holdbreath_onoff,Options[ modName_idx ]);
        if(modName_idx == 21)display_mod( center_x(sizeof(BUTTONLAYOUT)- 1, OLED_FONT_MEDIUM_WIDTH) ,BUTTONLAYOUT[0],BUTTON_LAYOUT,Options[ modName_idx ]);
        if(modName_idx == 22)display_mod( center_x(sizeof(STICKLAYOUT)- 1, OLED_FONT_MEDIUM_WIDTH) ,STICKLAYOUT[0],STICK_LAYOUT,Options[ modName_idx ]);
        if(modName_idx == 23)display_mod( center_x(sizeof(SMARTFIRE)- 1, OLED_FONT_MEDIUM_WIDTH) ,SMARTFIRE[0],smart_fire_onoff,Options[ modName_idx ]);
        if(modName_idx == 24)display_mod( center_x(sizeof(RAPIDFIRE)- 1, OLED_FONT_MEDIUM_WIDTH) ,RAPIDFIRE[0],rapidfire_onoff,Options[ modName_idx ]);
              
         refresh_OLED = FALSE; 
    } 
    if(display_title){           
          // clear OLED screen    
    	     cls_oled(0);            
    	     print(center_x(sizeof(TITLE) - 1, OLED_FONT_MEDIUM_WIDTH),13,OLED_FONT_MEDIUM,OLED_WHITE,TITLE[0]);
	         //print(center_x(sizeof(TITLE) - 1, OLED_FONT_SMALL_WIDTH),13,OLED_FONT_SMALL,OLED_WHITE,TITLE[0]);
           // screen saver          
	         ModMenu = FALSE;   
           display_title = FALSE;  
           display_black = TRUE;
                                   
    }                            
      
    //-----------------------------
    // Screen saver (OLED off)   
    if(display_black )         
    {                            
        count_black += get_rtime();
        if(count_black >= TimeToShowIntroPicture)   
        {                        
            cls_oled(0);         
            count_black = 0;      
            display_black = FALSE; 
        }                         
    }                           
                                
   /////////////////////////////////////////////////////////
   // MENU EDIT VALUES             
   if(ModEdit){ 
        block_all_inputs(); 
        if(MenuTimeOut){
            CheckIfBtnIsPressed();
        } 
       //--- Exit from EDIT MENU  
       if(event_release(XB1_B)){
             ModEdit      = FALSE;           
             display_EDIT = FALSE;           
             ModMenu      = TRUE;            
             refresh_OLED = TRUE;   // display MODS 
       }                    
        ////////////////////////////////////////////////////////////////////////////////  
        //  GO FORWARD                                                                      
        if(!get_ival(XB1_LT) && event_press(XB1_DOWN)){            
                                          
        	   adjust_variable_idx ++;                 
        	   if(adjust_variable_idx > OptRange[ modName_idx ][ 1 ])  adjust_variable_idx = OptRange[ modName_idx ][ 1 ]; 
             refresh_OLED = FALSE;      
             display_EDIT = TRUE;        
        }          
        ///////////////////////////////////////////////////////////////////////////////  
        //  GO BACK                                                                      
        if(!get_ival(XB1_LT) && event_press(XB1_UP)){  
                                                               
        	   adjust_variable_idx --;                                      
        	   if(adjust_variable_idx < OptRange[ modName_idx ][ 0 ]) adjust_variable_idx = OptRange[ modName_idx ][ 0 ];
             refresh_OLED = FALSE;      
             display_EDIT = TRUE;        
        }                                                           
            /////////////////////////////////////////////////////// 
        if(MenuTimeOut){
            CheckIfBtnIsPressed();
        }
   }// end of EDIT MENU    
   /////////////////////////////////////////////////////////
   // EDIT MENU ON/OFF            
   if(get_ival(XB1_LT) && event_press(XB1_MENU)){  
        ModMenu = TRUE;  
        // toggle EditMenu ON/OFF                      
                 modName_idx  = 0;                   
                 refresh_OLED = TRUE;   // display Title    
                 display_EDIT = FALSE;        
                 MenuTimeOut  = menu_time_active;
   }      
   /////////////////////////////////////////////////////////
   // MENU SYSTEM              
   if(ModMenu){  
        block_all_inputs(); 
      //--- Exit from MENU  
      if(event_press(XB1_B)){
          ModMenu = FALSE;                     
          ModEdit = FALSE;              
          combo_run(MESSAGE);             
      }                    
      //--- Enter in EDIT MENU 
      if(event_press(XB1_A)){
          ModMenu             = FALSE;   
          adjust_variable_idx = OptRange[ modName_idx ][ 0 ]; 
          ModEdit             = TRUE;   
          display_EDIT        = TRUE; 
      }                    
                                  
        //Display MOD NAME and togle status 
        // Switch MODs                     
        if( !get_ival(XB1_LT) && event_press(XB1_DOWN)){ 
                                          
        	   modName_idx ++;                 
        	   if(modName_idx > MAX_MODS_COUNT) modName_idx = 0; 
             //////////////////////////////////////
        	   blinck( modName_idx[modName_idx + 1]); 
             //////////////////////////////////////
        }                          
        if(!get_ival(XB1_LT) && event_press(XB1_UP)){  
                                                               
        	  modName_idx --;                                      
        	  if(modName_idx < 0) modName_idx = MAX_MODS_COUNT;
             //////////////////////////////////////
        	   blinck( modName_idx[modName_idx + 1]); 
             //////////////////////////////////////
          }                        
        	//////////////////////////
                                  
                                  
        // screen saver           
        display_black = FALSE;    
        display_title = FALSE;    
        //////////////////////////////  
        // display mod name and Toggle ON/OFF | Scroll Options 
        if(!get_ival(XB1_LT) ){    
             if(event_press(XB1_RIGHT)){ //   go back
                 modName_idx[modName_idx + 1] = f_go_back( modName_idx[modName_idx + 1] ); 
             }// go back 
             if(event_press(XB1_LEFT)){//   go forward
                 modName_idx[modName_idx + 1] = f_go_forward( modName_idx[modName_idx + 1] );
             }// go forward 
       } 
        refresh_OLED = TRUE;   
        set_val(XB1_RIGHT,0); 
        set_val(XB1_LEFT,0); 
        set_val(XB1_UP,0); 
        set_val(XB1_DOWN,0); 
        if(MenuTimeOut){
            CheckIfBtnIsPressed();
        }
    } 
    /////////////////////////////////////////////////////////////
