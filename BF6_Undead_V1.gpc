	      if(get_ival(POLAR_RY) > 0) s_val =  map(0, STEADY_AIM, 0, 180, (s_val * STEADY_AIM) / 180) 
	      else s_val = map(0, STEADY_AIM, 180, 360, (((s_val - 180) * STEADY_AIM) / 180));          
                                                                                              
	      Set_polar(POLAR_RS, s_val, isqrt((get_ival(XB1_RX) * get_ival(XB1_RX)) + (get_ival(XB1_RY) * get_ival(XB1_RY))), FALSE); 
