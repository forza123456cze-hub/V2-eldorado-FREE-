                on_the_fly_display(center_x(sizeof(HRECOIL_1)- 1,OLED_FONT_MEDIUM_WIDTH),HRECOIL_1[0],HRecoil_1[0]);
            }
		}// get RS        
                                                     
		                                       
		ANTI_RECOIL       = VRecoil_1;         
		ANTI_RECOIL_H     = HRecoil_1;     
	}                                                  
