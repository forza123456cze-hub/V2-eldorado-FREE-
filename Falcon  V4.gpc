ToggleBunnyHop        = get_pvar(SPVAR_14,0,1,0); 
auto_spot_onoff       = get_pvar(SPVAR_15,1,4,1); 
rumble_onoff          = get_pvar(SPVAR_16,0,1,0); 
VM_Speed              = get_pvar(SPVAR_17,1,5,0); 
stick_noise_onoff     = get_pvar(SPVAR_18,0,1,0); 
dropshot_onoff        = get_pvar(SPVAR_19,1,4,0); 
Crouch_Shot_OnOff     = get_pvar(SPVAR_20,0,1,0); 
AR_vertical        = get_pvar(SPVAR_21, 1,99, 20);
AR_horizontal      = get_pvar(SPVAR_22, -99,99, 0);
AimAssistTime     = get_pvar(SPVAR_23, 1,100, 20);
AimAssistSize     = get_pvar(SPVAR_24, 1,100, 15);
STEADY_AIM         = get_pvar(SPVAR_25, 2,90, 15);
 STEADY_AIM = (360 / STEADY_AIM) / 2; 
DAMRadius         = get_pvar(SPVAR_26, 1,100,15 );
DAMAngle          = get_pvar(SPVAR_27, 1,100,20);
DAMRadiusBoost    = get_pvar(SPVAR_28, 1,100,6);
DAMAngleBoost     = get_pvar(SPVAR_29, 1,100,10);
HeadShotStrength   = get_pvar(SPVAR_30, 1,99, 20);
HeadShotHoldTime   = get_pvar(SPVAR_31, 1,2000, 800);
quick_scope_val    = get_pvar(SPVAR_32, 50,600, 350);
RF_hold           = get_pvar(SPVAR_33, 1,1000, 20);
RF_release        = get_pvar(SPVAR_34, 1,1000, 30);
burstF_hold       = get_pvar(SPVAR_35, 100, 800, 510);
burstF_rest       = get_pvar(SPVAR_36, 100, 800, 350);
DeadZone           = get_pvar(SPVAR_37,0,50, 10);
drop_shot_hold    = get_pvar(SPVAR_38, 100,6000, 600);
drop_shot_rest    = get_pvar(SPVAR_39, 100,6000, 5000);

   slot_numb = get_slot();
   
Load();
update_oled();

}
main {
                                  
  
if(PreLoad){
	vm_tctrl(0);
	set_rgb(10,10,10);
	block_all_inputs();
	CurrentControl[CurrentControl] = Assign_Button(CurrentControl[CurrentControl]);
	if(event_release(CurrentControl[CurrentControl]) && get_ptime(CurrentControl[CurrentControl]) > 600){
		if(CurrentControl < MaxControls){
			CurrentControl++;
			update_oled();
			BeenHeld = FALSE;
		}
	}
	
	if(Update){
		Print(Controls[CurrentControl],Center,3,Small,WhiteColor,String);
		if(get_controller() == PIO_XB1){
			Print(ButtonsXbox[CurrentControl[CurrentControl]],Center,center_y(Medium_Height),Medium,WhiteColor,String);
		} else {
			Print(ButtonsPlayStation[CurrentControl[CurrentControl]],Center,center_y(Medium_Height),Medium,WhiteColor,String);
		}
	}
	
	if(event_release(CurrentControl[CurrentControl]) && get_ptime(CurrentControl[CurrentControl]) > 600){
		if(CurrentControl == MaxControls){
			PreLoad = 0;
			Save();
			reset_leds();
			combo_run(Menu_Save);
		}
	}
} else {
 if(get_ival(ADS_BTN)){
     if(event_press(PS4_SHARE)){
         EntireScript_OnOff    = !EntireScript_OnOff;
         blinck(EntireScript_OnOff);
         cls_oled(0);
         draw_rectangle();
        
         display_mod( center_x(sizeof(SCRIPT_ONOFF)- 1, OLED_FONT_MEDIUM_WIDTH) ,SCRIPT_ONOFF [0],EntireScript_OnOff ,1);
         show_mesage_time = 2000;
 		  
 		 if(!EntireScript_OnOff) set_Virtual_Machine_Speed(VM_Default); 
     }
 }
                          
 if(show_mesage_time){
     show_mesage_time -= get_rtime();
     if(show_mesage_time <= 0) {
         cls_oled(0);    
     }
 }
                               

 if(EntireScript_OnOff){
   
	if(ModEdit || ModMenu) set_Virtual_Machine_Speed(VM_Default);
    if(display_EDIT){                
    	 
        cls_oled(0);                        
      
		if(EditVal[ modName_idx ] == 0 ){  
			           
		    line_oled(1,45,127,45,1,0);    
		    print( center_x( 17, OLED_FONT_SMALL_WIDTH ), 20, OLED_FONT_SMALL, 1, NO_EDIT_VAR1[0] ); 
		    print( center_x( 12, OLED_FONT_SMALL_WIDTH ), 33, OLED_FONT_SMALL, 1, NO_EDIT_VAR2[0] ); 
		}                                                                                            
		else {
          display_edit( adjust_variable_idx [adjust_variable_idx + 1]);
          adjust_variable_idx [adjust_variable_idx + 1] = edit_val(adjust_variable_idx [adjust_variable_idx + 1] );
		}
   }
    if(refresh_OLED)
    { 
        
        cls_oled(0);       
                           
        
        draw_rectangle(); 
          
        if(modName_idx == 0)display_mod( center_x(sizeof(ANTIRECOIL)- 1, OLED_FONT_SMALL_WIDTH ) ,ANTIRECOIL[0],antirecoil_onoff,Options[ modName_idx ]);
        if(modName_idx == 1)display_mod( center_x(sizeof(BATTSSTICKYAIM)- 1, OLED_FONT_SMALL_WIDTH ) ,BATTSSTICKYAIM[0],ToggleBattsStickyAim,Options[ modName_idx ]);
        if(modName_idx == 2)display_mod( center_x(sizeof(STEADYAIM)- 1, OLED_FONT_SMALL_WIDTH ) ,STEADYAIM[0],steady_aim_onoff,Options[ modName_idx ]);
        if(modName_idx == 3)display_mod( center_x(sizeof(MOD66_4_VARIABLES)- 1, OLED_FONT_SMALL_WIDTH ) ,MOD66_4_VARIABLES[0],DamPolarAssist_On_Off,Options[ modName_idx ]);
        if(modName_idx == 4)display_mod( center_x(sizeof(SNEAKINGMOD69)- 1, OLED_FONT_SMALL_WIDTH ) ,SNEAKINGMOD69[0],sneaking_OnOff,Options[ modName_idx ]);
        if(modName_idx == 5)display_mod( center_x(sizeof(HEAD_SHOT_ASSIST)- 1, OLED_FONT_SMALL_WIDTH ) ,HEAD_SHOT_ASSIST[0],HeadShotAssist_onoff,Options[ modName_idx ]);
        if(modName_idx == 6)display_mod( center_x(sizeof(JUMPSHOT)- 1, OLED_FONT_SMALL_WIDTH ) ,JUMPSHOT[0],jumpshot_onoff,Options[ modName_idx ]);
        if(modName_idx == 7)display_mod( center_x(sizeof(QUICKSCOPE)- 1, OLED_FONT_SMALL_WIDTH ) ,QUICKSCOPE[0],quick_scope_onoff,Options[ modName_idx ]);
        if(modName_idx == 8)display_mod( center_x(sizeof(SCOPESHOT)- 1, OLED_FONT_SMALL_WIDTH ) ,SCOPESHOT[0],scopeshot_onoff,Options[ modName_idx ]);
        if(modName_idx == 9)display_mod( center_x(sizeof(RAPIDFIRE)- 1, OLED_FONT_SMALL_WIDTH ) ,RAPIDFIRE[0],rapidfire_onoff,Options[ modName_idx ]);
        if(modName_idx == 10)display_mod( center_x(sizeof(BURSTFIRE)- 1, OLED_FONT_SMALL_WIDTH ) ,BURSTFIRE[0],burst_fire_onoff,Options[ modName_idx ]);
        if(modName_idx == 11)display_mod( center_x(sizeof(HOLDBREATH)- 1, OLED_FONT_SMALL_WIDTH ) ,HOLDBREATH[0],holdbreath_onoff,Options[ modName_idx ]);
        if(modName_idx == 12)display_mod( center_x(sizeof(EASYRUN)- 1, OLED_FONT_SMALL_WIDTH ) ,EASYRUN[0],easyrun_onoff,Options[ modName_idx ]);
        if(modName_idx == 13)display_mod( center_x(sizeof(BUNNYHOP)- 1, OLED_FONT_SMALL_WIDTH ) ,BUNNYHOP[0],ToggleBunnyHop,Options[ modName_idx ]);
        if(modName_idx == 14)display_mod( center_x(sizeof(AUTO_SPOT)- 1, OLED_FONT_SMALL_WIDTH ) ,AUTO_SPOT[0],auto_spot_onoff,Options[ modName_idx ]);
        if(modName_idx == 15)display_mod( center_x(sizeof(RUMBLESONOFF)- 1, OLED_FONT_SMALL_WIDTH ) ,RUMBLESONOFF[0],rumble_onoff,Options[ modName_idx ]);
        if(modName_idx == 16)display_mod( center_x(sizeof(VMSPEED)- 1, OLED_FONT_SMALL_WIDTH ) ,VMSPEED[0],VM_Speed,Options[ modName_idx ]);
        if(modName_idx == 17)display_mod( center_x(sizeof(DEADZONE_MOD)- 1, OLED_FONT_SMALL_WIDTH ) ,DEADZONE_MOD[0],stick_noise_onoff,Options[ modName_idx ]);
        if(modName_idx == 18)display_mod( center_x(sizeof(DROPSHOT)- 1, OLED_FONT_SMALL_WIDTH ) ,DROPSHOT[0],dropshot_onoff,Options[ modName_idx ]);
        if(modName_idx == 19)display_mod( center_x(sizeof(CROUCHSHOT)- 1, OLED_FONT_SMALL_WIDTH ) ,CROUCHSHOT[0],Crouch_Shot_OnOff,Options[ modName_idx ]);
              
         refresh_OLED = FALSE; 
    } 
    if(display_title){           
          
    	    cls_oled(0);            
    	        
          DrawLogo(0, 0, 0);
         
	         ModMenu = FALSE;   
           display_title = FALSE;  
           display_black = TRUE;
                                   
    }                            
      
          //LEAKED BY ABUSHADAD                                                    FOR MORE SCRIPTS https://discord.gg/ASTR
    if(display_black )         
    {                            
        count_black += get_rtime();
        if(count_black >= TimeToShowIntroPicture)   
        {                        
            cls_oled(0);         
            count_black = 0;      
            display_black = FALSE; 
        }                         
    }                           
                                
   
   if(ModEdit){ 
        block_all_inputs(); 
        if(MenuTimeOut){
            CheckIfBtnIsPressed();
        } 
      
       if(event_release(PS4_CIRCLE)){
             ModEdit      = FALSE;           
             display_EDIT = FALSE;           
             ModMenu      = TRUE;            
             refresh_OLED = TRUE;  
       }                    
                                                                        
        if(!get_ival(ADS_BTN) && event_press(PS4_DOWN)){            
                                          
        	   adjust_variable_idx ++;                 
        	   if(adjust_variable_idx > OptRange[ modName_idx ][ 1 ])  adjust_variable_idx = OptRange[ modName_idx ][ 1 ]; 
             refresh_OLED = FALSE;      
             display_EDIT = TRUE;        
        }          
                                                                        
        if(!get_ival(ADS_BTN) && event_press(PS4_UP)){  
                                                               
        	   adjust_variable_idx --;                                      
        	   if(adjust_variable_idx < OptRange[ modName_idx ][ 0 ]) adjust_variable_idx = OptRange[ modName_idx ][ 0 ];
             refresh_OLED = FALSE;      
             display_EDIT = TRUE;        
        }                                                           
           
        if(MenuTimeOut){
            CheckIfBtnIsPressed();
        }
   }        
   if(get_ival(ADS_BTN) && event_press(PS4_OPTIONS)){  
        ModMenu = TRUE;  
                 
                 modName_idx  = 0;                   
                 refresh_OLED = TRUE;     
                 display_EDIT = FALSE;        
                 MenuTimeOut  = menu_time_active;
   }      
              
   if(ModMenu){  
        block_all_inputs(); 
      
      if(event_press(PS4_CIRCLE)){
          ModMenu = FALSE;                     
          ModEdit = FALSE;              
          combo_run(MESSAGE);             
      }                    
     
      if(event_press(PS4_CROSS)){
          ModMenu             = FALSE;   
          adjust_variable_idx = OptRange[ modName_idx ][ 0 ]; 
          ModEdit             = TRUE;   
          display_EDIT        = TRUE; 
      }                    
                                  
                       
        if( !get_ival(ADS_BTN) && event_press(PS4_DOWN)){ 
                                          
        	   modName_idx ++;                 
        	   if(modName_idx > MAX_MODS_COUNT) modName_idx = 0; 
             
        	   blinck( modName_idx[modName_idx + 1]); 
            
        }                          
        if(!get_ival(ADS_BTN) && event_press(PS4_UP)){  
                                                               
        	  modName_idx --;                                      
        	  if(modName_idx < 0) modName_idx = MAX_MODS_COUNT;
             
        	   blinck( modName_idx[modName_idx + 1]); 
             
          }                        
        	
                                  
                                  
           
        display_black = FALSE;    
        display_title = FALSE;    
        
        if(!get_ival(ADS_BTN) ){    
             if(event_press(PS4_RIGHT)){ 
                 modName_idx[modName_idx + 1] = f_go_back( modName_idx[modName_idx + 1] ); 
             }
             if(event_press(PS4_LEFT)){
                 modName_idx[modName_idx + 1] = f_go_forward( modName_idx[modName_idx + 1] );
             }
       } 
        refresh_OLED = TRUE;   
        set_val(PS4_RIGHT,0); 
        set_val(PS4_LEFT,0); 
        set_val(PS4_UP,0); 
        set_val(PS4_DOWN,0); 
        if(MenuTimeOut){
            CheckIfBtnIsPressed();
        }
    } 
    
   if(!ModEdit && !ModMenu){
             
             combo_run(Blink_MOD_ON);          
             
             set_Virtual_Machine_Speed (VM_Speed);
                                                   
        
         if(Crouch_Shot_OnOff && KS_Crouch_Shot){
                
             if(get_ival(ADS_BTN) && !Crouch_is_active){
                 Crouch_is_active = TRUE;
                 combo_run(CROUCH_SHOT_cmb);
             }
             if(event_release(ADS_BTN) &&  Crouch_is_active){
                  Crouch_is_active = FALSE;
                  combo_run(CROUCH_SHOT_cmb);
             }
         }
        
        if(rapidfire_onoff && KS_RapidFire ) { 
            
            if ((rapidfire_onoff == 2 && get_ival(ADS_BTN) && get_ival(FIRE_BTN)) || (rapidfire_onoff == 1 && get_ival(FIRE_BTN) && !get_ival(ADS_BTN)) || (rapidfire_onoff == 3 && get_ival(FIRE_BTN))) {
                 combo_run(RAPID_FIRE_cmb);         
            }                                       
          
        }                                   
                                         
        
		if(sneaking_OnOff  && KS_Sneaking){
			if(get_ival(PS4_LY) < -80) sneaking_start = TRUE;
			if(event_press(XB1_LT) || event_press(XB1_RT)){
				sneaking_start = FALSE;
			}
			if(sneaking_start) combo_run(SNEAKING_cmb);
		}
       
            if (DamPolarAssist_On_Off) {
            
                if (get_ival(ADS_BTN) || (DamPolarAssist_On_Off == DAMPolarAAHip && get_ival(FIRE_BTN))) {
                
                    DamX = get_ival(RX);   
                    DamY = get_ival(RY);           
                    ActualMagnitude = isqrt(pow(DamX,2) + pow(DamY,2));  
                    MaxMagnitude = (ActualMagnitude < 100);                      
                
                    if (DamPolarAssist_On_Off >= DamPolarBoost && get_ival(FIRE_BTN)) {
                            
                        RadiusDam = DAMRadius + DAMRadiusBoost;
                        AngleDam = DAMAngleBoost;
                        
                    } else {
                            
                        RadiusDam = DAMRadius;
                        AngleDam = 0;
                    }
                    
                    DamAngle += DAMAngle + AngleDam;                                                 
                    DamAngle = DamAngle % 360;                                            
                    DamSin = DamPolar[DamAngle % 360];                           
                    DamCos = DamPolar[(DamAngle + 270) % 360];                  
                    DamCos = (DamCos * RadiusDam) / 100;                         
                    DamSin = (DamSin * RadiusDam) / 100;                          
                
                    if (ActualMagnitude <= 10) {                                                      
                        
                        DamSin -= DamY;                                                              
                        DamCos -= DamX;                                                                 
                    
                    } else {                                                                                       
                            
                        DamSin = (DamSin * (200 - ((abs(DamY) + ActualMagnitude) / 10) * 10) / 200) * MaxMagnitude; 
                        DamCos = (DamCos * (200 - ((abs(DamX) + ActualMagnitude) / 10) * 10) / 200) * MaxMagnitude; 
                    }                                                  
                    
                    set_val(RX,clamp(DamX + DamCos, -100,100));
                    set_val(RY,clamp(DamY + DamSin, -100,100)); 
                }
            }

       
        if (burst_fire_onoff && KS_BurstFire) {
            if ((burst_fire_onoff == 2 && get_ival(ADS_BTN) && get_ival(FIRE_BTN)) || (burst_fire_onoff == 1 && get_ival(FIRE_BTN) && !get_ival(ADS_BTN)) || (burst_fire_onoff == 3 && get_ival(FIRE_BTN))) {
                combo_run(BurstFire_cmb);
            } else {
                combo_stop(BurstFire_cmb);
            }
        }

           //LEAKED BY ABUSHADAD                                                    FOR MORE SCRIPTS https://discord.gg/ASTR
            if(!rumble_onoff)
                block_rumble();
                                
		        
		        if(easyrun_onoff ) { 
                 
                 if(get_ival(LY) < -90 ) combo_run(SPRINT_cmb); 
               
		        }                                   
                                         
        //LEAKED BY ABUSHADAD                                                    FOR MORE SCRIPTS https://discord.gg/ASTR
        if(dropshot_onoff  && KS_drop_shot) {     
            if(dropshot_onoff == 1){
              
                if(get_ival(FIRE_BTN) && !get_ival(ADS_BTN) ) combo_run(DROP_SHOT_cmb); 
                
            }
            if(dropshot_onoff == 2){
               
                if(get_ival(FIRE_BTN) && get_ival(ADS_BTN) ) combo_run(DROP_SHOT_cmb); 
               
            }
            if(dropshot_onoff == 3){
               
                if(!get_ival(FIRE_BTN) && get_ival(ADS_BTN) ) combo_run(DROP_SHOT_cmb); 
              
            }  
            if(dropshot_onoff == 4){
               
                if(get_ival(FIRE_BTN) ) combo_run(DROP_SHOT_cmb); 
              
            } //LEAKED BY ABUSHADAD                                                    FOR MORE SCRIPTS https://discord.gg/ASTR
        }                                   
           
        if(jumpshot_onoff && KS_jumpshot) { 
            if(jumpshot_onoff == 1){
               
                if(get_ival(FIRE_BTN) && !get_ival(ADS_BTN) ) combo_run(JUMP_SHOT_cmb); 
               
            }
            if(jumpshot_onoff == 2){
               
                if(get_ival(FIRE_BTN) && get_ival(ADS_BTN) ) combo_run(JUMP_SHOT_cmb); 
               
            }
            if(jumpshot_onoff == 3){
              
                if(!get_ival(FIRE_BTN) && get_ival(ADS_BTN) ) combo_run(JUMP_SHOT_cmb); 
              
            } 
            if(jumpshot_onoff == 4){
              
                if(get_ival(FIRE_BTN)) combo_run(JUMP_SHOT_cmb); 
               
            } 
        }
		    if(scopeshot_onoff ) { 
            
             if(get_ival(FIRE_BTN) && !get_ival(ADS_BTN) ) set_val(ADS_BTN,100); 
            
		    }                                   
                                         
       
        if(holdbreath_onoff == 1 ) { 
            
             if( get_ival(ADS_BTN) ) set_val(SPRINT_BTN, 100);
           
        } 
        if(holdbreath_onoff == 2 ) {
             //-----------------------------
             if( get_ival(ADS_BTN) ){ 
                 hbreath_time += get_rtime();
                 if(hbreath_time > 100){
                     set_val(SPRINT_BTN, 100);
                 }
             }
             if(event_release(ADS_BTN)){
                 hbreath_time = 0;
             }//LEAKED BY ABUSHADAD                                                    FOR MORE SCRIPTS https://discord.gg/ASTR
             
        }         
		    
     if(antirecoil_onoff && KS_anti_recoil){                               
    	    if( get_ival(ADS_BTN) && get_ival(FIRE_BTN )) {      
    	        combo_run(AntiRecoil);                 
    	    }                                          
                                                           
    	    if( abs(get_ival(RY)) > AR_Release || abs(get_ival(RX)) > AR_Release) { 
    	        combo_stop (AntiRecoil);               
    	    }                                
             
            if(get_ival(PS4_R3)){
                if(event_press(PS4_UP)){
                    AR_vertical += 1;
                }
                if(event_press(PS4_DOWN)) {
                    AR_vertical -= 1;
                }
                set_val(PS4_UP,0); set_val(PS4_DOWN,0);
                                                       
                if(event_press(PS4_LEFT)){
                    AR_horizontal -= 1;
                }
                if(event_press(PS4_RIGHT)) {
                    AR_horizontal +=  1;
                }
                set_val(PS4_LEFT,0); set_val(PS4_RIGHT,0);
                                                                
               
               if(event_press(PS4_PS)){
                    combo_run(MESSAGE);       
               }
               set_val(PS4_PS,0);
           }
                                                  
     }  
            
            if(HeadShotAssist_onoff ) {
                RY_analog = HeadShotStrength * -1;
                if(get_ival(FIRE_BTN) && get_ptime(FIRE_BTN) < HeadShotHoldTime) {     
                    offset_analog(RY,RY_analog);    
                }
            }         
		   
		    if (quick_scope_onoff) {          
		        if (event_release(ADS_BTN) && (get_ptime(ADS_BTN) < 200)) { 
		            combo_run(QUICKSCOPE_cmb);                
		        } 
		    } 
                                                  
            if(time_to_clear_screen){               
                time_to_clear_screen -= get_rtime();
                if(time_to_clear_screen <= 0 ){     
                    QT_MESSAGE_TIMEOUT();     
                }                              
            }            
                          
    
    if(steady_aim_onoff){ 
	      s_val = atan2(get_ival(POLAR_RY)/256, get_ival(POLAR_RX)/256);
                                                                
	      if(get_ival(POLAR_RY) > 0) s_val =  map(0, STEADY_AIM, 0, 180, (s_val * STEADY_AIM) / 180) 
	      else s_val = map(0, STEADY_AIM, 180, 360, (((s_val - 180) * STEADY_AIM) / 180));          
                                                                                              
	      Set_polar(POLAR_RS, s_val, isqrt((get_ival(RX) * get_ival(RX)) + (get_ival(RY) * get_ival(RY))), FALSE);                //LEAKED BY ABUSHADAD                                                    FOR MORE SCRIPTS https://discord.gg/ASTR
    }
           
            if(ToggleBattsStickyAim){
                if(get_ival(FIRE_BTN))
                    combo_run(StickyAim);
            }

           
            if(ToggleBunnyHop)
            {
                  if(get_ival(JUMP_BTN) && get_ptime(JUMP_BTN) > 200) 
                      combo_run(Bunnyhop); 
            }
           
           if(auto_spot_onoff && KS_auto_spot){
              
               if( auto_spot_onoff == 1){
                   if ( get_ival(FIRE_BTN) && !get_ival(ADS_BTN)){ combo_run (AutoSpot_cmb);}
               }
              
               if( auto_spot_onoff == 2){
                   if ( get_ival(ADS_BTN) && !get_ival(FIRE_BTN)) combo_run (AutoSpot_cmb);
               }
              //LEAKED BY ABUSHADAD                                                    FOR MORE SCRIPTS https://discord.gg/ASTR
               if( auto_spot_onoff == 3){
                   if ( get_ival(FIRE_BTN)) combo_run (AutoSpot_cmb);
               }
                
               if( auto_spot_onoff == 4){
                   if(AlwaysON_ASpot) combo_run (AutoSpot_cmb);
                   if(event_press(SPOT_BTN)) AlwaysON_ASpot = !AlwaysON_ASpot;
               }
           }
            
            if( stick_noise_onoff ) { 
                RemoveStickNoise();
            }
                              
        } 
    }  
}
}
const int16 ValRange [][] ={
{ 1,99 }, 
{ -99,99 }, 
{ 1,100 }, 
{ 1,100 }, 
{ 2,90 }, 
{ 1,100 }, 
{ 1,100 }, 
{ 1,100 }, 
{ 1,100 }, 
{ 1,99 }, 
{ 1,2000 }, 
{ 50,600 }, 
{ 1,1000 }, 
{ 1,1000 },  //LEAKED BY ABUSHADAD                                                    FOR MORE SCRIPTS https://discord.gg/ASTR
{ 100,800 }, 
{ 100,800 }, 
{ 0,50 }, 
{ 100,6000 }, 
{ 100,6000 }  
};       
       

define VM_Default = 0;
function set_Virtual_Machine_Speed (f_speed){
    if     (f_speed == 0) vm_tctrl(-0);
    else if(f_speed == 1) vm_tctrl(-2);
    else if(f_speed == 2) vm_tctrl(-4);
    else if(f_speed == 3) vm_tctrl(-6);
    else if(f_speed == 4) vm_tctrl(-8);
    else if(f_speed == 5) vm_tctrl(-9);
}
           
int hbreath_time;
combo Bunnyhop{
    set_val(JUMP_BTN, 100);
    wait(40);
    set_val(JUMP_BTN, 0);
    wait(80);
    set_val(JUMP_BTN, 100);
    wait(40);
    set_val(JUMP_BTN, 0);
    wait(80);
}
