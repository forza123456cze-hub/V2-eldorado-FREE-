int Button;
int BeenHeld;
function Assign_Button(Var) {
	Button = get_button();
	if(!BeenHeld){
		if(ButtonHoldFor(Button,600)){
			Var = Button;
			update_oled();
			BeenHeld = TRUE;
		}
	}
	return Var;
}
function get_button() {
if(get_ival(0)){
	return 0;
}
if(get_ival(1)){
	return 1;
}
if(get_ival(2)){
	return 2;
}
if(get_ival(3)){
	return 3;
}
if(get_ival(4)){
	return 4;
}
if(get_ival(5)){
	return 5;
}
if(get_ival(6)){
	return 6;
}
if(get_ival(7)){
	return 7;
}
if(get_ival(8)){
	return 8;
}
if(get_ival(13)){
	return 13;
}
if(get_ival(14)){
	return 14;
}
if(get_ival(15)){
	return 15;
}
if(get_ival(16)){
	return 16;
}
if(get_ival(17)){
	return 17;
}
if(get_ival(18)){
	return 18;
}
if(get_ival(19)){
	return 19;
}
if(get_ival(20)){
	return 20;
}
if(get_ival(27)){
	return 27;
}
return 0;
}
function ButtonHoldFor(button,time){
	return get_ival(button) && get_ptime(button) > time;
}
