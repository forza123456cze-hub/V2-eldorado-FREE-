int angle_Out;          
function atan2(y, x) {  
  if (x >= 0 && y > 0) angle_Out = -90;  
  else if (x  < 0 && y >= 0) angle_Out = 90; 
  else if (x <= 0 && y < 0) angle_Out = -270; 
  else angle_Out = 270;                       
                                              
  x = abs(x);                                 
  y = abs(y);                                 
                                              
  if (x < y) angle_Out += (x * 45 / y);       
  else if (x > y) angle_Out += 90 - (y * 45 / x); 
  else angle_Out += 45;                           
                                                  
  angle_Out = abs(angle_Out % 360);               
                                                  
  return (angle_Out);                             
}                                                 

function map(inMin, inMax, outMin, outMax, x) {                                  
  return (x - inMin) * (outMax - outMin) / (inMax - inMin) + outMin;             
}                                                                                

int cos_angle, sin_angle;                           
function Set_polar(stick, angle, radius, offset) {  
  if(angle < 0) angle = 360 + (angle % 360);        
  angle = (angle + 90) % 360;                       
                                                    
  sin_angle = dint8(angle);                         
  cos_angle = dint8((angle + 90) % 360);            
                                                    
  if(offset){                                       
    offset(7 + stick, (cos_angle * radius) / 100); 
    offset(8 + stick, (sin_angle * radius) / 100);  
  } else {                                          
    set_val(7 + stick, (cos_angle * radius) / 100); 
    set_val(8 + stick, (sin_angle * radius) / 100); 
  }                                                  
  return;                                           
}                                                    

function offset(axis, offset_val) {                                             
  set_val(axis, clamp(offset_val * (100 - abs(get_ival(axis))) / 100 + get_ival(axis), -100, 100));
  return 
}        //LEAKED BY ABUSHADAD                                                    FOR MORE SCRIPTS https://discord.gg/ASTR

