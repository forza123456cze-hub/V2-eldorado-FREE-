fmxJh6);            }        }        if(currentMod == 2) {            if(fn_VKGrSykw(MOD_INCREASE)) {                var_X0wKXUyz = fn_9oUn85F6(var_X0wKXUyz++, 0, 100);                display_mod_menu();                set_pvar(SPVAR_3, var_X0wKXUyz);            }            if(fn_VKGrSykw(MOD_DECREASE)) {                var_X0wKXUyz = fn_9oUn85F6(var_X0wKXUyz--, 0, 100);                display_mod_menu();                set_pvar(SPVAR_3, var_X0wKXUyz);            }        }                  if (currentMod == 3) {            if (event_press(MOD_INCREASE) || event_press(MOD_DECREASE) || event_press(MOD_SELECT)) {                 if (AutoAim == 0) AutoAim = 1;                else if (AutoAim == 1) AutoAim = 0;                display_mod_menu();                set_pvar(SPVAR_4, AutoAim);            }        }                 if (currentMod == 4) {            if (event_press(MOD_INCREASE) || event_press(MOD_DECREASE) || event_press(MOD_SELECT)) {                if (BloomReducer == 0) BloomReducer = 1;                else if (BloomReducer == 1) BloomReducer = 0;                display_mod_menu();                set_pvar(SPVAR_5, BloomReducer);            }        }                           if (currentMod == 5) {            if (event_press(MOD_INCREASE) || event_press(MOD_DECREASE) || event_press(MOD_SELECT)) {                if (var_XfxNE5yY == 0) var_XfxNE5yY = 1;                else if (var_XfxNE5yY == 1) var_XfxNE5yY = 0;                display_mod_menu();                set_pvar(SPVAR_6, var_XfxNE5yY);            }        }                                        if(currentMod == 6) {            if(fn_VKGrSykw(MOD_INCREASE)) {                var_hz3eF9Ya = fn_9oUn85F6(var_hz3eF9Ya++, 5, 50);                var_DEZ2D4qR = fn_vvuVmAka(var_hz3eF9Ya);                display_mod_menu();                set_pvar(SPVAR_7, var_hz3eF9Ya);            }            if(fn_VKGrSykw(MOD_DECREASE)) {                var_hz3eF9Ya = fn_9oUn85F6(var_hz3eF9Ya--, 5, 50);                var_DEZ2D4qR = fn_vvuVmAka(var_hz3eF9Ya);                display_mod_menu();                set_pvar(SPVAR_7, var_hz3eF9Ya);            }        }     if (currentMod == 7) {            if (event_press(MOD_INCREASE) || event_press(MOD_DECREASE) || event_press(MOD_SELECT)) {                 if (var_YKH9dgQu == 0) var_YKH9dgQu = 1;                else if (var_YKH9dgQu == 1) var_YKH9dgQu = 0;                display_mod_menu();                set_pvar(SPVAR_8, var_YKH9dgQu);            }        }                                 if (currentMod == 8) {            if (event_press(MOD_INCREASE) || event_press(MOD_DECREASE) || event_press(MOD_SELECT)) {                 if (var_NoSHvuUk == 0) var_NoSHvuUk = 1;                else if (var_NoSHvuUk == 1) var_NoSHvuUk = 0;                display_mod_menu();                set_pvar(SPVAR_9, var_NoSHvuUk);            }        }                   if (currentMod == 9) {            if (event_press(MOD_INCREASE) || event_press(MOD_SELECT)) {                if (var_GdLZBulS == 2) var_GdLZBulS = 0;                else var_GdLZBulS++;            }            if (event_press(MOD_DECREASE)) {                if (var_GdLZBulS == 0) var_GdLZBulS = 2;                else var_GdLZBulS--;            }            display_mod_menu();            set_pvar(SPVAR_10, var_GdLZBulS);        }                                 if (currentMod == 10) {        if (event_press(MOD_DECREASE)) {        if (Dropshot < 1) Dropshot = 2;        else Dropshot--;        display_mod_menu();        if (Dropshot == 0) {            set_pvar(SPVAR_11, 0);        } else if (Dropshot == 1) {            set_pvar(SPVAR_11, 1);        } else {            set_pvar(SPVAR_11, 2);        }    }            if (event_press(MOD_INCREASE)) {        if (Dropshot > 1) Dropshot = 0;        else Dropshot++;        display_mod_menu();        if (Dropshot == 0) {            set_pvar(SPVAR_11, 0);        } else if (Dropshot == 1) {            set_pvar(SPVAR_11, 1);        } else {            set_pvar(SPVAR_11, 2);        }    }}        if(currentMod == 11) {            if(fn_VKGrSykw(MOD_INCREASE)) {                var_b3262LbM = fn_9oUn85F6(var_b3262LbM++, 0, 50);                display_mod_menu();                set_pvar(SPVAR_12, var_b3262LbM);            }            if(fn_VKGrSykw(MOD_DECREASE)) {                var_b3262LbM = fn_9oUn85F6(var_b3262LbM--, 0, 50);                display_mod_menu();                set_pvar(SPVAR_12, var_b3262LbM);            }        }                    if (currentMod == 12) {            if (event_press(MOD_INCREASE) || event_press(MOD_DECREASE) || event_press(MOD_SELECT)) {                if (EditAssist == 0) EditAssist = 1;                else if (EditAssist == 1) EditAssist = 0;                display_mod_menu();                set_pvar(SPVAR_14, EditAssist);            }        }                if (event_press(MOD_BACK)) {            SaveMods();            modMenuActive = 0;            cls_oled(0);          combo_run(ltrs3221);        }     }            if(var_YKH9dgQu)	{		if(event_press(SWITCHMODE))		{			var_E4TkVaRS = !var_E4TkVaRS;					}		if(var_E4TkVaRS)		{			var_YbPO07Ug += get_rtime();			if(event_press(pic3920KAXE) || var_YbPO07Ug == 3000)			{				var_E4TkVaRS = FALSE;				var_YbPO07Ug = 0;			}			if(get_ival(XB1_LB) || get_ival(XB1_RB) || get_ival(XB1_LT) || get_ival(XB1_RT) || get_ival(XB1_X)) 				var_YbPO07Ug = 0;		}	}	if(!var_E4TkVaRS)	{				if(var_kCmgt8SH)		{			if(get_ival(ADS) || get_ival(def_2331KnKH))			{				var_9HuHiMH5 += var_X0wKXUyz;				if(var_9HuHiMH5 >= 360) { var_9HuHiMH5 -= 360; }				fn_TzZ0aWWr(XB1_RX, var_EdfmxJh6 * sin[var_9HuHiMH5] / 100);				fn_TzZ0aWWr(XB1_RY, var_EdfmxJh6 * cos[var_9HuHiMH5] / 100);			}			else			{				var_9HuHiMH5 = 0;			}		}		if(var_XfxNE5yY == 1)		{			combo_run(combo_2uwUP5mN);			combo_run(combo_ElmcMKX8);			combo_run(combo_oxr58NXy);			combo_run(combo_DD4xX22S);			combo_run(combo_tSdzTyDy);			combo_run(combo_cPZTCjVV);			combo_run(combo_vdQvaPX5);			combo_run(combo_TAMCrEPX);			if(get_val(def_2331KnKH))			{				combo_run(combo_mB0AOg7u);			}			combo_run(combo_V16cvKrc);			combo_run(combo_qWykip2z);			if(abs(get_val(XB1_RY)) + abs(get_val(XB1_RX)) > 15)			{				combo_stop(combo_qWykip2z);			}		}	}                                                  if (get_ival(def_jUY32kNs) && event_press(def_9JA0sG9g) && combo_QuGZcUCw) {        combo_QuGZcUCw = !combo_QuGZcUCw;    }    if (get_ival(def_2331KnKH) && (Dropshot == 1 || ((Dropshot == 2) && get_val(ADS)))) {        combo_run(Dropshot);    }    if (combo_QuGZcUCw && get_ival(ADS) && get_ival(def_2331KnKH)) {        combo_run(combo_QuGZcUCw);    }    if (var_GdLZBulS == 1 && get_ival(XB1_RB) && get_ival(XB1_LB)) {        combo_run(PickupMacroCombo);    }    if (var_GdLZBulS == 2 && get_ival(INTERACT)) {        combo_run(PickupMacroCombo);    }    if (event_press(def_I3MMieM8) && get_ival(def_gada006F)) {        AutoAim = !AutoAim;        combo_run(combo_T1mFj0qT);        if (AutoAim == 1) {            set_rgb(234, 0, 255);        } else {            set_rgb(255, 0, 0);        }    }    if (AutoAim == 1) {        set_rgb(234, 0, 255);    } else {        set_rgb(255, 0, 0);    }    if (AutoAim && StrafeShot && (!get_ival(ADS) || def_kE0j56mo || get_ival(def_2331KnKH)) &&        abs(get_ival(LX)) <= 35 && abs(get_ival(LY)) <= 35 && !get_ival(XB1_X)) {        combo_run(StrafeShot);    } else {        combo_stop(StrafeShot);    }if (EditAssist == 1) {    if ( get_ival(Edit_Assist_Button)) {    if (!Edass) {    combo_run(combo_edit);      }    if (Edass) {   set_val(def_2331KnKH,100);   }    } else {    Edass = FALSE;    set_val(def_2331KnKH,0);      }}    if (var_NoSHvuUk == 1) {        combo_run(combo_5JXlcQ0X);    }    if (BloomReducer == 1) {        if (get_ival(ADS) && get_ival(def_2331KnKH)) {            combo_stop(AimAssistThree);            if (abs(get_ival(LX)) <= 40 && abs(get_ival(LY)) <= 40) {                combo_run(AntiBloom);            } else {                combo_stop(AntiBloom);            }        } else if (get_ival(def_2331KnKH) && !get_ival(ADS) &&                   abs(get_ival(LX)) <= 70 && abs(get_ival(LY)) <= 70) {            combo_run(AimAssistThree);        } else {            combo_stop(AimAssistThree);            combo_stop(AntiBloom);        }    }                            }combo AimAssistThree {    set_val(LX, -100 + get_ival(LX));    wait(15);    set_val(LX, 100 + get_ival(LX));    wait(15);}combo AntiBloom {    set_val(LX, -40);    wait(50);    set_val(LX, 40);    wait(50);}combo combo_edit {    wait(1);     Edass = TRUE;}combo combo_5JXlcQ0X {    if (get_ival(ADS)) {        set_val(ADS, 100);    }    if (get_ival(def_2331KnKH)) {        set_val(def_2331KnKH, 100);    }}combo pic3920{fn_6pVFa0Nm();}	function fn_6pVFa0Nm() {image_oled(0, 0, TRUE, TRUE, ltrs3221[0]);}combo PickupMacroCombo {	set_val(INTERACT, 100);	wait(1);	set_val(INTERACT, 0);	wait(1);	}combo StrafeShot {	set_val(XB1_LX, -100 + get_ival(PS4_LX));	wait(1);	set_val(XB1_LX, 100 + get_ival(PS4_LX));	wait(1);	}combo combo_QuGZcUCw {	var_FlUIoQSu = get_ival(PS4_RY) + var_HWyoMPeV;	if (var_FlUIoQSu > 100) var_FlUIoQSu = 100;	if (abs(get_val(PS4_RY)) < abs(var_HWyoMPeV) + 5) set_val(PS4_RY, 