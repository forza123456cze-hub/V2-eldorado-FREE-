combo flash_rgb {
    wait(1000); // Wait for 1 second before clearing the RGB
    set_rgb(255, 50, 0); // Reset RGB to default (off or neutral color)
}



combo Dropshot {
	set_val(SLIDE, 100);
	wait(DropshotWaitTime);
	set_val(SLIDE, 0);
	wait(DropshotWaitTime);
	}

	

combo AntiRecoil {
	AntirecoilVertical = get_ival(PS4_RY) + AntiRecoilStrength;
	if (AntirecoilVertical > 100) AntirecoilVertical = 100;
	if (abs(get_val(PS4_RY)) < abs(AntiRecoilStrength) + 5) set_val(PS4_RY, (AntirecoilVertical));
	}


combo YYSpam {
    set_val(SWITCH, 100);  // Press the "Y" button.
    wait(32);              // Hold the button for 32ms.
    wait(120);             // Fixed delay after first button press.
    set_val(SWITCH, 100);  // Press the "Y" button again.
    wait(48);              // Hold the button for 48ms.
    wait(160);             // Fixed delay after second button press.
}

combo SlideCancel {
    set_val(SLIDE, 100);  // Press SLIDE
    wait(60 + randomize);  // Hold for 60 ms + random variation
    set_val(SLIDE, 0);    // Release SLIDE
    wait(60 + randomize);  // Wait for 60 ms + random variation
    set_val(SLIDE, 100);  // Press SLIDE again
    wait(50 + randomize);  // Hold for 50 ms + random variation
    set_val(SLIDE, 100);  // Hold SLIDE
    set_val(JUMP, 100);    // Press jump
    wait(60 + randomize);  // Hold both for 60 ms + random variation
    set_val(SLIDE, 0);    // Release SLIDE
    set_val(JUMP, 100);    // Keep jump pressed
    wait(10 + randomize);  // Wait for 10 ms + random variation
    set_val(JUMP, 0);      // Release jump
}
	combo AutoPing{
	set_val(PS4_UP,100);
	wait(20)
	set_val(PS4_UP,0);
	wait(20)
	set_val(PS4_UP,100);
	wait(20)
	set_val(PS4_UP,0);
}

		combo Bunnyhop{
	set_val(JUMP, 100);
	wait(30);
	set_val(JUMP, 0);
	wait(30);
	set_val(JUMP, 100);
	wait(30);
	set_val(JUMP, 0);
	wait(30);
}
		combo RapidFire {
	set_val(FIRE, 100);
	wait(hold_time);
	set_val(FIRE,   0);
	wait(rest_time);

}





int double__tap;
function double_click(button) {
	if (double__tap[button] >= 0) {
		double__tap[button] += get_rtime();
		if (double__tap[button] > 450)
		double__tap[button] = -1;
	}
	if (event_release(button) && get_ptime(button) <= 200) {
		if (double__tap[button] < 0) {
			double__tap[button] = 0;
		} else {
			double__tap[button] = -1;
			return 1;
		}
	}
	return 0;
}
function get_mvt_direction( _val, _lval) {
	if(abs(_val - _lval) <= 2)
		return 0;

	if(_val < _lval)
		return -1;

	if(_val > _lval)
		return 1;
	return 0;
}

function sin(angle) {
	if(angle <= 90)
	{             
		_ret = (TrackerCords[angle]);
	}
	else if(angle <= 180)
	{      
		_ret = (TrackerCords[180 - angle]);
	}
	else if(angle <= 270)
	{
		_ret = inv(TrackerCords[angle - 180]);
	}
	else 
	{
		_ret = inv(TrackerCords[360 - angle]);
	}
		return _ret;
}

function cos(angle) {   
	if(angle <= 90)
	{             
		_ret = (TrackerCords[90 - angle]);
	}
	else if(angle <= 180)
	{      
		_ret = inv(TrackerCords[angle - 90]);
	}
	else if(angle <= 270)
	{
		_ret = inv(TrackerCords[270 - angle]);
	}
	else 
	{
		_ret = (TrackerCords[angle - 270]);
	}
		return _ret;
}

function get_polar_coordinate(Radius, coef) {
	if(Radius > 32)
	{
		Radius = 32;
	}
		return((Radius * coef) / 1000);
}








// Alternative For The Missing Ternary Operator
function iif(Expression, TrueVar, FalseVar) {
	if(Expression)		// Evaluate if Expression is true
		return TrueVar;	// Return TrueVar
	return FalseVar;	// Else Return FalseVar
}

function Cycle(fVal, fLow, fHigh) {
	return iif(fVal > fHigh, fLow, iif(fVal < fLow, fHigh, fVal));
}

function press_hold(fButton) {
	return event_press(fButton) || (get_ival(fButton) && get_ptime(fButton) > 250 && !(get_ptime(fButton) % (get_rtime() << 3)));
}


