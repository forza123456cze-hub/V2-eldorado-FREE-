et_val(XB1_RX, var_DEZ2D4qR);    set_val(XB1_RY, inv(var_DEZ2D4qR));    wait(1);    set_val(XB1_RX, inv(var_DEZ2D4qR));    set_val(XB1_RY, var_DEZ2D4qR);    wait(1);}combo combo_V16cvKrc {    set_val(XB1_RX, AXRL(XB1_RX, var_DEZ2D4qR));    wait(1);    set_val(XB1_RX, AXRL(XB1_RX, var_DEZ2D4qR * inv(1)));    wait(1);}combo combo_T1mFj0qT {set_rumble(RUMBLE_B,20);wait(150);reset_rumble();}function AXRL(AxisXY, AxisVal) {    if(abs(get_ival(AxisXY)) < ExpoStrength + inv(1) && abs(get_ival(AxisVal)) < ExpoStrength + inv(1) + get_val(ExpoStrength))        return AxisVal;    return get_val(AxisXY);}function fn_ozjjhYvL() {	fn_gwyjl372(PS4_RX);	fn_gwyjl372(PS4_RY);	fn_gwyjl372(PS4_LX);	fn_gwyjl372(PS4_LY);}function fn_gwyjl372(var_hnenH2i6) {	var_oYvgniOS = get_ival(var_hnenH2i6); 	if(var_oYvgniOS >= inv(def_OuSOL8om) && var_oYvgniOS <= def_OuSOL8om)	{		set_val(var_hnenH2i6, 0); 	}	else if(var_oYvgniOS < inv(def_OuSOL8om))	{		set_val(var_hnenH2i6, clamp((var_oYvgniOS + def_OuSOL8om) * 100 / (100 - def_OuSOL8om), inv(100), 100));			}	else if(var_oYvgniOS > def_OuSOL8om)	{		set_val(var_hnenH2i6, clamp((var_oYvgniOS - def_OuSOL8om) * 100 / (100 - def_OuSOL8om), inv(100), 100));			}}function fn_vvuVmAka(var_c2wlrXsb) {	var_P1RwRWWE	= var_c2wlrXsb * 100;	var_Riigabcz			= var_P1RwRWWE / 135;	var_r3vyLyfW	= var_P1RwRWWE % 135;	if(var_r3vyLyfW >= 68)	{		var_Riigabcz += 1;	}		return var_Riigabcz;}function fn_6G3kiEuP(var_HEVwY7gW, var_xbNKsdHK, var_ixksYTd2) {	if(var_HEVwY7gW)				return var_xbNKsdHK;		return var_ixksYTd2;	}function fn_9oUn85F6(var_5WY7pYBY, var_Jnhq90dY, var_9aiEJPyr) {	return fn_6G3kiEuP(var_5WY7pYBY > var_9aiEJPyr, var_Jnhq90dY, fn_6G3kiEuP(var_5WY7pYBY < var_Jnhq90dY, var_9aiEJPyr, var_5WY7pYBY));}function fn_VKGrSykw(var_LKZqGrL1) {	return event_press(var_LKZqGrL1) || (get_ival(var_LKZqGrL1) && get_ptime(var_LKZqGrL1) > 250 && !(get_ptime(var_LKZqGrL1) % (get_rtime() << 2)));}			function fn_TzZ0aWWr(var_xzzVyvkF, var_Jz2akki5) {    set_val(var_xzzVyvkF, clamp(var_Jz2akki5 * (100 - abs(get_val(var_xzzVyvkF))) / 100 + get_val(var_xzzVyvkF), inv(100), 100));}function fn_JUzj49YS(var_j79pD2BL, var_ts4O2Uw5, var_NKQjO4Xe) {	var_MY9S6DUr	= 1;	var_h7fRNCDK			= 10000;	if(var_j79pD2BL < 0) 	{		putc_oled(var_MY9S6DUr, 45);		var_MY9S6DUr += 1;		var_j79pD2BL = abs(var_j79pD2BL);	}	for(var_DF32cWnl = 5; var_DF32cWnl >= 1; var_DF32cWnl--)	{		if(var_ts4O2Uw5 >= var_DF32cWnl)		{			putc_oled(var_MY9S6DUr, strArr_W1HotAuI[var_j79pD2BL / var_h7fRNCDK]);			var_j79pD2BL %= var_h7fRNCDK;			var_MY9S6DUr += 1;			if(var_DF32cWnl == 4) 			{				putc_oled(var_MY9S6DUr, 44);				var_MY9S6DUr += 1;			}		}			var_h7fRNCDK /= 10;	}		}function fn_bvNPql7C(var_XSCSHID1) {	var_XSCSHID1 = abs(var_XSCSHID1);	if(var_XSCSHID1 / 10000 > 0)	return 5;	if(var_XSCSHID1 /  1000 > 0)	return 4;	if(var_XSCSHID1 /   100 > 0)	return 3;	if(var_XSCSHID1 /    10 > 0)	return 2;							return 1;}		combo ltrs3221 {    image_oled(0, 0, TRUE, TRUE, ltrs3221[0]);    wait(20);    image_oled(0, 0, TRUE, TRUE, ltrs3221[1]);    wait(20);    image_oled(0, 0, TRUE, TRUE, ltrs3221[2]);    wait(20);    image_oled(0, 0, TRUE, TRUE, ltrs3221[3]);    wait(20);    image_oled(0, 0, TRUE, TRUE, ltrs3221[4]);    wait(20);    image_oled(0, 0, TRUE, TRUE, ltrs3221[5]);    wait(20);    image_oled(0, 0, TRUE, TRUE, ltrs3221[6]);    wait(20);    image_oled(0, 0, TRUE, TRUE, ltrs3221[7]);    wait(20);    image_oled(0, 0, TRUE, TRUE, ltrs3221[8]);    wait(20);    image_oled(0, 0, TRUE, TRUE, ltrs3221[9]);    wait(20);    image_oled(0, 0, TRUE, TRUE, ltrs3221[10]);    wait(20);    image_oled(0, 0, TRUE, TRUE, ltrs3221[11]);    wait(20);    image_oled(0, 0, TRUE, TRUE, ltrs3221[12]);    wait