function SaveMods() {



    set_pvar(SPVAR_1, AntiRecoilStrength);
	set_pvar(SPVAR_2, XYTracker);
	set_pvar(SPVAR_3, XYXYExtraSpeedAA);
	set_pvar(SPVAR_4, XYMagnet);
	set_pvar(SPVAR_5, AutoPing);
	set_pvar(SPVAR_6, Dropshot);
	set_pvar(SPVAR_7, BunnyHop);
	set_pvar(SPVAR_8, SlideCancel);
	set_pvar(SPVAR_9, YYSpam);
	set_pvar(SPVAR_10, RapidFire);
	set_pvar(SPVAR_11, HairTriggers);
	
}


function ResetScript() {	// Make These Match The Def. Value From LoadDefaults()
    AntiRecoilStrength       = 0;
	XYTracker	            = 15;
	XYXYExtraSpeedAA		= 30;
	XYMagnet	            =  0;
	AutoPing			     = 0;
	Dropshot	             = 0;
	BunnyHop =                 0;
	SlideCancel =              0;
	YYSpam =                   0;
	RapidFire =                0;
	HairTriggers =             0;
	
	
}


function LoadDefaults() {
                                      //	Min. Max. 	Def.

    AntiRecoilStrength	= get_pvar(SPVAR_1, 0, 	50, 0);
	XYTracker	= get_pvar(SPVAR_2, 0, 	50, 15);
	XYXYExtraSpeedAA		= get_pvar(SPVAR_3, 0, 	100, 30);
	XYMagnet	= get_pvar(SPVAR_4, 0, 1, 0);
	AutoPing			= get_pvar(SPVAR_5, 0, 1, 0);
	Dropshot             = get_pvar(SPVAR_6, 0, 1, 0);
	BunnyHop        = get_pvar(SPVAR_7, 0, 1, 0);
	SlideCancel         = get_pvar(SPVAR_8, 0, 1, 0);
	YYSpam        = get_pvar(SPVAR_9, 0, 1, 0);
	RapidFire	= get_pvar(SPVAR_10, 0, 1, 0);
	HairTriggers            = get_pvar(SPVAR_11, 0, 1, 0);
  
	
	
}





