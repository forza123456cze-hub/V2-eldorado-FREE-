//discord.gg/coldz

init {

set_rgb(255, 50, 0);
	cls_oled(0);

	if(get_pvar(SPVAR_64, 0, 10, 5) != 9) 
	{
		set_pvar(SPVAR_64, 9):
		ResetScript();
		SaveMods();
	}

	LoadDefaults();
	




}







//discord.gg/coldz

main {

 

    if (!modMenuActive && get_val(MOD_MENU_TOGGLE_HOLD) && event_press(MOD_MENU_TOGGLE_PRESS)) {
        modMenuActive = TRUE;
        display_mod_menu();
    }
    
    if (modMenuActive) {
        if (event_press(MOD_NEXT)) {
            if ((currentMod + 1) < modAmount) currentMod++;
            else currentMod = 0;
            display_mod_menu();
        }
        if (event_press(MOD_PREVIOUS)) {
            if (currentMod > 0) currentMod--;
            else currentMod = modAmount - 1;
            display_mod_menu();
        }

        if (currentMod == 0) {
            if (press_hold(MOD_INCREASE)) {
                AntiRecoilStrength = Cycle(AntiRecoilStrength++, 0, 50);
                display_mod_menu();
                set_pvar(SPVAR_1, AntiRecoilStrength);
            }
            if (press_hold(MOD_DECREASE)) {
                AntiRecoilStrength = Cycle(AntiRecoilStrength--, 0, 50);
                display_mod_menu();
                set_pvar(SPVAR_1, AntiRecoilStrength);
            }
        }

        if (currentMod == 1) {
            if (press_hold(MOD_INCREASE)) {
                XYTracker = Cycle(XYTracker++, 0, 50);
                display_mod_menu();
                set_pvar(SPVAR_2, XYTracker);
            }
            if (press_hold(MOD_DECREASE)) {
                XYTracker = Cycle(XYTracker--, 0, 50);
                display_mod_menu();
                set_pvar(SPVAR_2, XYTracker);
            }
        }

        if (currentMod == 2) {
            if (press_hold(MOD_INCREASE)) {
                XYXYExtraSpeedAA = Cycle(XYXYExtraSpeedAA++, 0, 100);
                display_mod_menu();
                set_pvar(SPVAR_3, XYXYExtraSpeedAA);
            }
            if (press_hold(MOD_DECREASE)) {
                XYXYExtraSpeedAA = Cycle(XYXYExtraSpeedAA--, 0, 100);
                display_mod_menu();
                set_pvar(SPVAR_3, XYXYExtraSpeedAA);
            }
        }

        if (currentMod == 3) {
            if (event_press(MOD_INCREASE) || event_press(MOD_DECREASE) || event_press(MOD_SELECT)) {
                XYMagnet = !XYMagnet;
                display_mod_menu();
                set_pvar(SPVAR_4, XYMagnet);
            }
        }

        if (currentMod == 4) {
            if (event_press(MOD_INCREASE) || event_press(MOD_DECREASE) || event_press(MOD_SELECT)) {
                AutoPing = !AutoPing;
                display_mod_menu();
                set_pvar(SPVAR_5, AutoPing);
            }
        }

        if (currentMod == 5) {
            if (event_press(MOD_DECREASE)) {
                if (Dropshot < 1) Dropshot = 2;
                else Dropshot--;
                display_mod_menu();
                set_pvar(SPVAR_6, Dropshot);
            }

            if (event_press(MOD_INCREASE)) {
                if (Dropshot > 1) Dropshot = 0;
                else Dropshot++;
                display_mod_menu();
                set_pvar(SPVAR_6, Dropshot);
            }
        }

        if (currentMod == 6) {
            if (event_press(MOD_INCREASE) || event_press(MOD_DECREASE) || event_press(MOD_SELECT)) {
                BunnyHop = !BunnyHop;
                display_mod_menu();
                set_pvar(SPVAR_7, BunnyHop);
            }
        }

        if (currentMod == 7) {
            if (event_press(MOD_INCREASE) || event_press(MOD_DECREASE) || event_press(MOD_SELECT)) {
                SlideCancel = !SlideCancel;
                display_mod_menu();
                set_pvar(SPVAR_8, SlideCancel);
            }
        }

        if (currentMod == 8) {
            if (event_press(MOD_INCREASE) || event_press(MOD_DECREASE) || event_press(MOD_SELECT)) {
                YYSpam = !YYSpam;
                display_mod_menu();
                set_pvar(SPVAR_9, YYSpam);
            }
        }

        if (currentMod == 9) {
            if (event_press(MOD_INCREASE) || event_press(MOD_DECREASE) || event_press(MOD_SELECT)) {
                RapidFire = !RapidFire;
                display_mod_menu();
                set_pvar(SPVAR_10, RapidFire);
            }
        }

        if (currentMod == 10) {
            if (event_press(MOD_INCREASE) || event_press(MOD_DECREASE) || event_press(MOD_SELECT)) {
                HairTriggers = !HairTriggers;
                display_mod_menu();
                set_pvar(SPVAR_11, HairTriggers);
            }
        }

        if (event_press(MOD_BACK)) {
            SaveMods();
            modMenuActive = 0;
            cls_oled(0);
        }
    }
    
      // Anti-recoil toggle
    if (get_ival(AntiRecoilToggleHold) && event_press(AntiRecoilTogglePress) && AntiRecoil) {
        AntiRecoil = !AntiRecoil;
    }

    // Dropshot combo
    if (get_ival(FIRE) && (Dropshot == 1 || ((Dropshot == 2) && get_val(ADS)))) {
        combo_run(Dropshot);
    }

    // Anti-recoil and YYSpam combo
    if (AntiRecoil && get_ival(ADS) && get_ival(FIRE)) {
        combo_run(AntiRecoil);
    }

     
    if (SlideCancel) {
        if (abs(get_val(PS4_LY)) > 80) {  // Movement threshold check
            if (event_release(SLIDE)) {  // Trigger combo on SLIDE button release
                randomize = random(-20, 20); // Generate a random value
                combo_run(SlideCancel);
            }
        }
    }

    if(AutoPing)
	{
		if(get_val(ADS)&& double_click(PS4_UP)||event_press(FIRE))
		combo_run(AutoPing);

		if(!get_val(ADS))
		combo_stop(AutoPing);
	}

    if(HairTriggers) {
			if(get_ival(ADS)){
				set_val(ADS,100);
				}
			if(get_ival(FIRE)){
				set_val(FIRE,100);
				}
			}

    if(BunnyHop){

		if(get_ival(JUMP) && get_ptime(JUMP) > 200)
		combo_run(Bunnyhop);

    }
    
    
    
    
    
    
      if (XYTracker > 0 && XYXYExtraSpeedAA > 0) {
        // Drift calibration
        if (drift_calib) {
            rx_drift = max(rx_drift, abs(get_ival(PS4_RX)) + 2);
            ry_drift = max(ry_drift, abs(get_ival(PS4_RY)) + 2);
            lx_drift = max(lx_drift, abs(get_ival(PS4_LX)) + 2);
            ly_drift = max(ly_drift, abs(get_ival(PS4_LY)) + 2);

            rx_drift = min(rx_drift, 15);
            ry_drift = min(ry_drift, 15);
            lx_drift = min(lx_drift, 15);
            ly_drift = min(ly_drift, 15);

            drift_calib--; // Decrease drift calibration value

            // Max drift values
            rx_drift = max(rx_drift, ry_drift);
            lx_drift = max(lx_drift, ly_drift);
        } else {
            // Reset controller values when no drift calibration
            C_RX = get_ival(PS4_RX);
            C_RY = get_ival(PS4_RY);
            C_LX = get_ival(PS4_LX);
            C_LY = get_ival(PS4_LY);

            // Check for drift and zero values if below drift threshold
            if (isqrt(pow(C_RX, 2) + pow(C_RY, 2)) <= rx_drift) {
                C_RX = 0;
                C_RY = 0;
            }
            if (isqrt(pow(C_LX, 2) + pow(C_LY, 2)) <= lx_drift) {
                C_LX = 0;
                C_LY = 0;
            }

            // Handle ADS or FIRE conditions //discord.gg/coldz
            if (get_val(ADS) > 50 || get_val(FIRE) > 50) {
                if (update_timer >= 40) {
                    block(PS4_RX, 40);
                    block(PS4_RY, 40);

                    _ret = get_mvt_direction(C_RX, L_RX);
                    if (_ret != 0) mvt_direction = _ret;

                    update_timer = 0;
                    L_RX = C_RX;
                    L_RY = C_RY;
                }

                set_val(PS4_RX, clamp(C_RX, -100, 100));
                set_val(PS4_RY, clamp(C_RY, -100, 100));
                update_timer += get_rtime();
            } else {
                update_timer = 0;
                update_timer = 40;
                TrackerAngle = 90;

                set_val(PS4_RX, C_RX);
                set_val(PS4_RY, C_RY);
            }

            set_val(PS4_LX, C_LX);
            set_val(PS4_LY, C_LY);
        }

        // Polar aim logic
        stick_input = isqrt(pow(get_ival(PS4_RX), 2) + pow(get_ival(PS4_RY), 2));

        if (XYTracker > 0) {
            if (XYBOOSTER && get_ival(FIRE)) {
                Radius = XYTracker + XYBoost;
            } else {
                Radius = XYTracker;
            }

            if (get_ival(ADS) || get_ival(FIRE)) {
                if (stick_input <= Radius) {
                    RS_gr = (RS_gr + XYXYExtraSpeedAA) % 360;
                    set_polar(POLAR_RS, RS_gr, (Radius * random(326, 328)));
                }
            }
        }

        // Handle Tracker logic
        if (get_val(ADS) > 50 || get_val(FIRE) > 50) {
            if (update_timer >= 40) {
                block(PS4_RX, 40);
                block(PS4_RY, 40);

                _ret = get_mvt_direction(C_RX, L_RX);
                if (_ret != 0) mvt_direction = _ret;

                update_timer = 0;
                L_RX = C_RX;
                C_RY = C_RY;
            }

            if (XYTracker) {
                if (mvt_direction == 1) {
                    C_RX += get_polar_coordinate(XYExtraAA, sin(TrackerAngle));
                    C_RY += get_polar_coordinate(XYExtraAA, cos(TrackerAngle));
                } else {
                    C_RX += get_polar_coordinate(XYExtraAA, cos(TrackerAngle));
                    C_RY += get_polar_coordinate(XYExtraAA, sin(TrackerAngle));
                }
                TrackerAngle = ((TrackerAngle + XYExtraSpeedAA) % 360);
            }

            set_val(PS4_RX, clamp(C_RX, -100, 100));
            set_val(PS4_RY, clamp(C_RY, -100, 100));
            update_timer += get_rtime();
        } else {
            update_timer = 0;
            update_timer = 40;

            TrackerAngle = 0 ;

            set_val(PS4_RX, C_RX);
            set_val(PS4_RY, C_RY);
        }
    }
    
    
    
    
    
    
    


if (get_ival(XYMagnetHold)) {
    set_val(XYMagnetPress, 0);
    if (event_press(XYMagnetPress)) {
        XYMagnet = !XYMagnet; // Toggle XYMagnet state
        combo_run(rumble); // Rumble feedback
        
        // Flash RGB based on the toggle state
        if (XYMagnet) {
            set_rgb(0, 255, 0); // Green flash for "on"
        } else {
            set_rgb(255, 0, 0); // Red flash for "off"
        }
        combo_run(flash_rgb); // Reset RGB after 1 second
    }
}




	if (XYMagnet && (XYMAGNETAnytimeADSing || (get_ival(ADS) && get_ival(FIRE)))) { 
    combo_run(cStrafe);
}


   



if (get_ival(RapidFireHold)) {
    set_val(RapidFirePress, 0);
    if (event_press(RapidFirePress)) {
        RapidFire = !RapidFire; // Toggle rapid-fire state
        combo_run(rumble); // Rumble feedback
        
        // Flash RGB based on the toggle state
        if (RapidFire) {
            set_rgb(0, 255, 0); // Green flash for "on"
        } else {
            set_rgb(255, 0, 0); // Red flash for "off"
        }
        combo_run(flash_rgb); // Reset RGB after 1 second
    }
}
 if(RapidFire){

		hold_time = 500 / (  RateOfFire);
		rest_time = hold_time - 20;
		if(rest_time < 0) rest_time = 0;

		if(get_val(FIRE))combo_run(RapidFire );
		else combo_stop(RapidFire );


	}





    if (YYSpam) {
        if (YYSpam == 1) {
            YYSpamming = get_ival(SPRINT);
        }

        if (get_ival(ADS) || get_ival(FIRE) || get_ival(SLIDE)) {
            YYSpamming = FALSE;
        }

        if (YYSpamming) {
            combo_run(YYSpam);
            set_val(ADS, 0);
            set_val(FIRE, 0);
        }
    }

} 

	

    
    



