// Constant Strings
const string _buttonLayoutNames[] = { "Default", "Tactical", "Lefty", "Nomad/Charlie", "Nomad/Charlie Tact", "Nomad/Charlie Left", "Bumper Jumper", "Bumper Jumper Tact", "1-hand Gunslinger", "Stick and Move", "Brawler", "Beast", "Custom" }
const string _homeScreenStrings[] = { "Fox", "FPS Script", "LethalPanda", "Version " }
const string _menuScreenFooters[] = { " to Save & Exit", " to Adjust", " to Scroll" }
const string _menuScreenNames[] = { "AimLock v1", "AimLock v1 Size", "AimLock v1 Speed", "Auto Hold Breath", "Auto Ping", "Button Layout", "Block Vibration", "Bunny Hop", "Flipped", "Hair Triggers", "Inverted", "Rapid Fire", "Slide Cancel", "Stick Layout", "Sticky Aim", "Sticky Aim Size", "Sticky Aim Time", "YY Spam" }
