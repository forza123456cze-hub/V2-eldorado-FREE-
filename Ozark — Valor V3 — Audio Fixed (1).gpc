function V_048(V_049) {
	V_0394[V_0393[V_0282]] = V_055(V_0394[V_0393[V_0282]], V_0393[V_0283], V_0393[V_0284], V_049, TRUE);
}
function V_050(V_049) {
	V_0393[V_0286] = V_055(V_0393[V_0286], 0x0, V_0405[V_0396[V_0364]], V_049, FALSE);
	V_0186(V_0393[V_0286]);
}
function V_052(V_053, V_049) {
	V_0394[V_053] = clamp(V_0394[V_053] + V_049, V_0393[V_0287], V_0393[V_0288]);
	V_0390[V_0270] = TRUE;
}
function V_055(V_056, V_057, V_058, V_049, V_060) {
	if(V_049 > 0x0) {
		if(V_056 + V_049 <= V_058) {
			V_0390[V_0270] = TRUE;
			return V_056 + V_049;
		} else if(V_060) {
			V_0390[V_0270] = TRUE;
			return V_057;
		}
	} else {
		if(V_056 + V_049 >= V_057) {
			V_0390[V_0270] = TRUE;
			return V_056 + V_049;
		} else if(V_060) {
			V_0390[V_0270] = TRUE;
			return V_058;
		}
	}
	return V_098(V_049 > 0x0, V_058, V_057);
}
function V_061(V_062) {
	V_0396[V_0364] = V_062;
	V_0396[V_0365] = 0x0;
	V_0390[V_0270] = TRUE;
	reset_leds();
	if(V_062 == V_0368) {
		V_0152();
		V_0153();
		fal_apply_trigger_style(); // re-apply after V_0152 reloads button table
		V_0396[V_0366] = 0x0; 
		vm_tctrl(V_0687[V_0394[V_0217]]);
		set_led(LED_1, 0x1);
		set_led(LED_2, 0x1);
		set_led(LED_3, 0x1);
		// Reset Valor-style idle screen animation
		fal_idle_phase = 0;
		fal_idle_hold = fal_idle_hold_text;
		fal_idle_sweep_y = 0;
	}
	else if(V_062 == V_0369) {
		// Entering mod menu — start on Valor-style category select
		fal_menu_state    = 1;
		fal_cat_prev      = -1;             // force slide-anim init
		fal_scroll_cur    = fal_cat_idx * 13;
		fal_scroll_target = fal_scroll_cur;
		vm_tctrl(0x0); 
		set_led(LED_4, 0x1); 
	}
	else if(V_062 > V_0369) {
		V_0393[V_0286] = 0x0; 
		V_0393[V_0290] = 0x1; 
		V_0186(0x0); 
		set_led(LED_4, 0x1); 
	}
	else {
		vm_tctrl(0x0); 
		set_led(LED_4, 0x1); 
	}
}
function V_063() {
	if(V_0396[V_0364] != V_0368) {
		return FALSE;
	}
	if(V_0396[V_0365] >= V_0192) {
		return TRUE;
	}
	V_0396[V_0365] += get_rtime();
	if(V_0396[V_0365] >= V_0192) {
		cls_oled(OLED_BLACK);
		return TRUE;
	}
	return FALSE;
}
