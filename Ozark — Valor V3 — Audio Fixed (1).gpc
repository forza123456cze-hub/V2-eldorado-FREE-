// ----- Idle screen: full animated sweep cycle -----
function fal_draw_idle_animated() {
    cls_oled(OLED_BLACK);
    fal_draw_idle_text();
}

// ----- Category screen: vertical sliding list with bouncing balls -----
function fal_draw_category_menu() {
    cls_oled(OLED_BLACK);

    if (fal_cat_idx != fal_cat_prev) {
        fal_cat_prev = fal_cat_idx;
        fal_anim_frames = 10;
        fal_scroll_target = fal_cat_idx * 13;
    }

    if (fal_anim_frames > 0) {
        fal_scroll_cur = fal_scroll_cur + ((fal_scroll_target - fal_scroll_cur) / fal_scroll_step);
        fal_anim_frames = fal_anim_frames - 1;
        if (fal_anim_frames == 0) { fal_scroll_cur = fal_scroll_target; }
    }

    fal_cat_iter = 0;
    while (fal_cat_iter < fal_cat_count) {
        fal_item_y = 16 + (fal_cat_iter * 20) - fal_scroll_cur;
        if (fal_item_y >= -20 && fal_item_y <= 74) {
            fal_cat_name_chars = fal_get_str_len(fal_cat_names[fal_cat_iter]) - 1;
            fal_cat_x_pos = 64 - ((fal_cat_name_chars * 7) / 2);
            print(fal_cat_x_pos, fal_item_y, OLED_FONT_SMALL, OLED_WHITE, fal_cat_names[fal_cat_iter]);
            if (fal_cat_iter == fal_cat_idx) {
                print(2,   fal_item_y, OLED_FONT_SMALL, OLED_WHITE, fal_nav_arrow_left[0]);
                print(119, fal_item_y, OLED_FONT_SMALL, OLED_WHITE, fal_nav_arrow_right[0]);
            }
        }
        fal_cat_iter++;
    }

    // Bouncing balls
    fal_ball_y = fal_ball_y + (fal_ball_dir * fal_ball_speed);
    if (fal_ball_y >= fal_ball_max) { fal_ball_y = fal_ball_max; fal_ball_dir = -1; }
    if (fal_ball_y <= fal_ball_min) { fal_ball_y = fal_ball_min; fal_ball_dir = 1; }
    pixel_oled(4, fal_ball_y - 3, 1);
    rect_oled(2, fal_ball_y - 2, 5, 5, 1, OLED_WHITE);
    pixel_oled(4, fal_ball_y + 3, 1);
    pixel_oled(123, fal_ball_y - 3, 1);
    rect_oled(121, fal_ball_y - 2, 5, 5, 1, OLED_WHITE);
    pixel_oled(123, fal_ball_y + 3, 1);
}

// ----- Mod page: nav arrows on title row -----
function fal_draw_nav_arrows(current_page, total_pages) {
    if (current_page > 0) {
        print(2, 8, OLED_FONT_SMALL, OLED_WHITE, fal_nav_arrow_left[0]);
    }
    if (current_page < total_pages - 1) {
        print(119, 8, OLED_FONT_SMALL, OLED_WHITE, fal_nav_arrow_right[0]);
    }
}

// ----- Mod page: pagination dots at bottom -----
function fal_draw_page_dots(current_page, total_pages) {
    fal_dot_count_total = total_pages;
    if (fal_dot_count_total <= 1) { return; }
    fal_dot_step = 13;
    if (fal_dot_count_total > 8) { fal_dot_step = 8; }
    fal_dot_origin_x = (128 - ((fal_dot_count_total - 1) * fal_dot_step) - 5) / 2;
    fal_dot_idx = 0;
    while (fal_dot_idx < fal_dot_count_total) {
        if (fal_dot_idx == current_page) {
            rect_oled(fal_dot_origin_x + (fal_dot_idx * fal_dot_step), 58, 5, 5, 1, 1);
        } else {
            rect_oled(fal_dot_origin_x + (fal_dot_idx * fal_dot_step) + 1, 59, 3, 3, 1, 1);
        }
        fal_dot_idx++;
    }
}

