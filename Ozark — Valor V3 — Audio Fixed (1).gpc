function V_081(V_082, V_083, V_084, V_085) {
	if(V_082 == V_0273) {
		V_082 = OLED_WIDTH - (V_0390[V_0265] * V_0673[V_084]) - 0x3; 
	} else if(V_082 == V_0271) {
		V_082 = (OLED_WIDTH >> 0x1) - ((V_0390[V_0265] * V_0673[V_084]) >> 0x1);
	}
	if(V_083 == V_0272) {
		V_083 = OLED_HEIGHT - V_0672[V_084] - 0x2; 
	} else if(V_083 == V_0271) {
		V_083 = (OLED_HEIGHT >> 0x1) - (V_0672[V_084] >> 0x1);
	}
	puts_oled(clamp(V_082, 0x2, 0x7F), clamp(V_083, 0x2, 0x3F), V_084, V_0390[V_0265], V_085);
	V_0390[V_0265] = 0x0;
}
function V_086(V_082, V_083) {
    V_081(V_082, V_083, OLED_FONT_MEDIUM, OLED_WHITE);
}
function V_089(V_082, V_083) {
    V_081(V_082, V_083, OLED_FONT_SMALL, OLED_WHITE);
}
function V_092() {
	switch(V_098(V_0394[V_0223] > V_0225, V_0394[V_0223] - V_0225, V_0394[V_0223])) {
		case V_0220 {
			V_0111[V_0386] = XB1_LS;
			break;
		} case V_0354 {
			V_0111[V_0386] = XB1_RS;
			break;
		} case V_0355 {
			V_0111[V_0386] = V_098(abs(get_val(POLAR_RY)) > abs(get_val(POLAR_LX)), XB1_LS, XB1_RS);
			break;
		} case V_0356 {
			V_0111[V_0386] = V_098(abs(get_val(POLAR_LY)) > abs(get_val(POLAR_RX)), XB1_RS, XB1_LS);
			break;
		} case V_0357 {
			V_0111[V_0386] = XB1_RS;
			break;
		} case V_0225 {
			V_0111[V_0386] = V_098(abs(get_val(POLAR_LY)) > abs(get_val(POLAR_RX)), XB1_RS, XB1_LS);
			break;
		}
	}
	V_0111[V_0387] = get_polar(V_098(V_0111[V_0386] == XB1_LS, POLAR_LS, POLAR_RS), POLAR_RADIUS);
}
function V_093(V_094) {
	switch(V_0396[V_0364]) {
		case V_0370 { return V_016(V_094); }
		case V_0371 { return V_018(V_094); }
		case V_0373 { return V_020(V_094); }
		case V_0374 { return V_022(V_094); }
		case V_0375 { return V_024(V_094); }
		case V_0376 { return V_026(V_094); }
		case V_0378 { return V_028(V_094); }
		case V_0379 { return V_030(V_094); }
		case V_0380 { return V_032(V_094); }
		case V_0381 { return V_034(V_094); }
	}
	return 0x0;
}
function V_095() {
	if(V_0392[V_0279] && event_press(XB1_MENU)) {
		V_061(V_0369);
		V_0185();
		return;
	}
}
function V_096() {
	// Valor-style two-state navigation:
	//   State 1 = category select screen
	//   State 2 = mod page (single mod)

	// ------------- State 1: CATEGORY SELECT -------------
	if (fal_menu_state == 1) {
		// B = exit menu (save + return to idle)
		if(event_release(XB1_B)) {
			V_0156();
			return;
		}
		// UP/DOWN cycle categories
		if(event_press(XB1_DOWN)) {
			fal_cat_idx++;
			if (fal_cat_idx >= fal_cat_count) { fal_cat_idx = 0; }
			V_0390[V_0270] = TRUE;
			return;
		}
		if(event_press(XB1_UP)) {
			fal_cat_idx--;
			if (fal_cat_idx < 0) { fal_cat_idx = fal_cat_count - 1; }
			V_0390[V_0270] = TRUE;
			return;
		}
		// CROSS (A) = enter selected category -> mod page
		if(event_press(XB1_A)) {
			fal_menu_state   = 2;
			fal_cat_page_idx  = 0;
			fal_cat_page_count = fal_cat_sizes[fal_cat_idx];
			V_0396[V_0366]   = fal_get_cat_mod(fal_cat_idx, fal_cat_page_idx);
			V_0185();
			V_0390[V_0270] = TRUE;
			return;
		}
		return;
	}

	// ------------- State 2: MOD PAGE -------------
	// B = back to category select
	if(event_release(XB1_B)) {
		fal_menu_state = 1;
		fal_cat_prev = -1;          // force animation re-init
		fal_scroll_cur = fal_cat_idx * 13;
		fal_scroll_target = fal_scroll_cur;
		V_0390[V_0270] = TRUE;
		return;
	}
	// LEFT/RIGHT cycle through mods within the current category
	if(event_press(XB1_RIGHT)) {
		if (fal_cat_page_idx < fal_cat_page_count - 1) {
			fal_cat_page_idx++;
			V_0396[V_0366] = fal_get_cat_mod(fal_cat_idx, fal_cat_page_idx);
			V_0185();
			V_0390[V_0270] = TRUE;
		}
		return;
	}
	if(event_press(XB1_LEFT)) {
		if (fal_cat_page_idx > 0) {
			fal_cat_page_idx--;
			V_0396[V_0366] = fal_get_cat_mod(fal_cat_idx, fal_cat_page_idx);
			V_0185();
			V_0390[V_0270] = TRUE;
		}
		return;
	}
	// UP/DOWN toggle the current mod option
	if(event_press(XB1_UP)) {
		if (V_0396[V_0366] == 99) {
			fal_trigger_style = 1 - fal_trigger_style;
			fal_apply_trigger_style();
		} else {
			V_048(0x1);
		}
		V_0390[V_0270] = TRUE;
		return;
	}
	if(event_press(XB1_DOWN)) {
		if (V_0396[V_0366] == 99) {
			fal_trigger_style = 1 - fal_trigger_style;
			fal_apply_trigger_style();
		} else {
			V_048(inv(0x1));
		}
		V_0390[V_0270] = TRUE;
		return;
	}
	// A = enter EDIT screen
	if(event_press(XB1_A)) {
		V_061(V_0396[V_0366]);
		return;
	}
}
function V_097() {
	if(event_release(XB1_B)) {
		// Go back to mod page (state 2), not category select
		V_061(V_0369);
		fal_menu_state = 2;
		V_0396[V_0366] = fal_get_cat_mod(fal_cat_idx, fal_cat_page_idx);
		V_0185();
		V_0390[V_0270] = TRUE;
		return;
	}
	if(get_ival(XB1_LT)) {
		if(event_press(XB1_UP)) {
			V_052(V_0393[V_0290], 0xA);
			return;
		}
		if(event_press(XB1_DOWN)) {
