// ===============================================================
// VALOR-STYLE OLED MENU STATE (visual-only port)
// ===============================================================

// Branding strings shown on animated idle screen
const string FAL_BRAND   = "OZARKSCRIPTS.COM";
const string FAL_LABEL   = "VALOR";
const string FAL_VERSION = "V3";

// Idle animation state machine:
//   phase 0 = text held visible
//   phase 1 = sweep line moving DOWN (wipe text)
//   phase 2 = logo held visible
//   phase 3 = sweep line moving UP (reveal text)
int fal_idle_phase = 0;
int fal_idle_sweep_y = 0;
int fal_idle_hold = 220;
int fal_idle_hold_text = 220;
int fal_idle_hold_logo = 220;

// ArcScript-style mod menu sub-state (used while V_0396[V_0364] == V_0369):
//   1 = category select screen
//   2 = mod page (single mod with arrows + dots)
int fal_menu_state = 1;
int fal_cat_idx = 0;
int fal_cat_prev = -1;
int fal_cat_count = 5;
int fal_cat_page_idx = 0;
int fal_cat_page_count = 0;

// Slide animation (lerps scroll_cur toward scroll_target over 10 frames)
int fal_anim_frames = 0;
int fal_scroll_cur = 0;
int fal_scroll_target = 0;
int fal_scroll_step = 4;
int fal_item_y = 0;
int fal_cat_iter = 0;
int fal_cat_x_pos = 0;
int fal_cat_name_chars = 0;

// Bouncing balls on the left/right edges of the category screen
int fal_ball_y = 30;
int fal_ball_dir = 1;
int fal_ball_min = 3;
int fal_ball_max = 60;
int fal_ball_speed = 2;

// Sub-menu pagination dots
int fal_dot_idx = 0;
int fal_dot_count_total = 0;
int fal_dot_step = 0;
int fal_dot_origin_x = 0;

// Category lookup result (no local int8 inside lookup function)
int fal_cat_lookup_result = 0;

// String length helper result
int fal_string_length = 0;

// Helper: returns X coordinate to horizontally center f_chars-wide text in given font
function fal_center_x(f_chars, f_font) {
    return (OLED_WIDTH / 2) - ((f_chars * f_font) / 2);
}

// Category names — same structure as Valor's cat_names[].
// print() and fal_get_str_len() can index into these directly.
const string fal_cat_names[]       = { "Aim Assist", "Recoil", "Combat", "Movement", "Settings" };
const string fal_nav_arrow_left[]  = { "<" };
const string fal_nav_arrow_right[] = { ">" };
const string fal_nav_arrow_up[]    = { "^" };
const string fal_nav_arrow_dn[]    = { "v" };
const string fal_trigger_labels[]  = { "L2/R2", "L1/R1" };
const string fal_trig_name[]       = { "Trigger Style" };
int fal_trigger_style = 0; // 0=L2/R2 (default), 1=L1/R1

// Maps category + sub-page index -> Valor mod index (V_014 input).
// modName_idx mapping (from V_014):
//   0  Anti Recoil          1  Auto-Tracking AI       2  LS Assist
//   3  L2&R2 Boost       4  YY Spam             5  Slide Cancel
//   6  Head AA          7  Breath Hold         8  Ping Enemy
//   9  Dodge Shot           10 Rapid Fire          11 L2 Abuse
//   12 VM Speed             13 Button Layout       14 Stick Layout
const int8 fal_cat_mods_aim[]      = { 1, 3, 6, 8 };   // Auto-Tracking AI, L2&R2 Boost, Head AA, Ping Enemy
const int8 fal_cat_mods_recoil[]   = { 0 };            // Anti Recoil
const int8 fal_cat_mods_combat[]   = { 10, 7 }; // Rapid Fire, Breath Hold
const int8 fal_cat_mods_movement[] = { 4, 5, 2 };      // YY Spam, Slide Cancel, LS Assist
const int8 fal_cat_mods_settings[] = { 12, 14, 99 };   // VM Speed, Stick Layout, Trigger Style
const int8 fal_cat_sizes[]         = { 4, 1, 2, 3, 3 };

// ===============================================================
// VALOR-STYLE MENU HELPERS
// ===============================================================

// Counts characters until null terminator, returns length+1 (matches Valor)
function fal_get_str_len(offset) {
    fal_string_length = 0;
    while (duint8(offset++)) {
        fal_string_length++;
    }
    return fal_string_length + 1;
}

// Returns valor mod index for a given (cat, sub) pair
function fal_get_cat_mod(cat, sub) {
    fal_cat_lookup_result = 0;
    if (cat == 0)      { fal_cat_lookup_result = fal_cat_mods_aim[sub]; }
    else if (cat == 1) { fal_cat_lookup_result = fal_cat_mods_recoil[sub]; }
    else if (cat == 2) { fal_cat_lookup_result = fal_cat_mods_combat[sub]; }
    else if (cat == 3) { fal_cat_lookup_result = fal_cat_mods_movement[sub]; }
    else if (cat == 4) { fal_cat_lookup_result = fal_cat_mods_settings[sub]; }
    return fal_cat_lookup_result;
}


// Segmented block bar — filled squares for active, outlined for empty
int fal_bar_filled, fal_bar_i, fal_bar_bx;
int FAL_BAR_SEGS   = 16;
int FAL_SEG_W      = 6;
int FAL_SEG_H      = 6;
int FAL_SEG_GAP    = 1;
int FAL_SEG_Y      = 52;
int FAL_SEG_START  = 4;
function fal_draw_bar(value, min_val, max_val) {
    if (max_val == min_val) { fal_bar_filled = 0; }
    else { fal_bar_filled = (value - min_val) * FAL_BAR_SEGS / (max_val - min_val); }
    if (fal_bar_filled < 0)             fal_bar_filled = 0;
    if (fal_bar_filled > FAL_BAR_SEGS)  fal_bar_filled = FAL_BAR_SEGS;
    fal_bar_i = 0;
    while (fal_bar_i < FAL_BAR_SEGS) {
        fal_bar_bx = FAL_SEG_START + fal_bar_i * (FAL_SEG_W + FAL_SEG_GAP);
        if (fal_bar_i < fal_bar_filled) {
            rect_oled(fal_bar_bx, FAL_SEG_Y, FAL_SEG_W, FAL_SEG_H, 1, OLED_WHITE);
        } else {
            line_oled(fal_bar_bx,               FAL_SEG_Y,               fal_bar_bx + FAL_SEG_W - 1, FAL_SEG_Y,               1, OLED_WHITE);
            line_oled(fal_bar_bx,               FAL_SEG_Y + FAL_SEG_H - 1, fal_bar_bx + FAL_SEG_W - 1, FAL_SEG_Y + FAL_SEG_H - 1, 1, OLED_WHITE);
            line_oled(fal_bar_bx,               FAL_SEG_Y,               fal_bar_bx,               FAL_SEG_Y + FAL_SEG_H - 1, 1, OLED_WHITE);
            line_oled(fal_bar_bx + FAL_SEG_W - 1, FAL_SEG_Y,               fal_bar_bx + FAL_SEG_W - 1, FAL_SEG_Y + FAL_SEG_H - 1, 1, OLED_WHITE);
        }
        fal_bar_i++;
    }
}


// Apply trigger style — swaps aim/fire buttons and deadzone
function fal_apply_trigger_style() {
    if (fal_trigger_style == 0) {
        // L2/R2 — default
        V_0103[V_0248] = XB1_LT;
        V_0103[V_0252] = XB1_RT;
    } else {
        // L1/R1
        V_0103[V_0248] = XB1_LB;
        V_0103[V_0252] = XB1_RB;
    }
}

// Display Trigger Style mod page
function fal_display_trigger_style() {
    print(fal_center_x(fal_get_str_len(fal_trig_name[0]), OLED_FONT_SMALL_WIDTH), 10, OLED_FONT_SMALL, OLED_WHITE, fal_trig_name[0]);
    print(fal_center_x(fal_get_str_len(fal_trigger_labels[fal_trigger_style]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, fal_trigger_labels[fal_trigger_style]);
}

// ----- Idle screen: text frame -----
function fal_draw_idle_text() {
    print(fal_center_x(fal_get_str_len(FAL_BRAND[0]),   OLED_FONT_SMALL_WIDTH),  6,  OLED_FONT_SMALL,  OLED_WHITE, FAL_BRAND[0]);
    print(fal_center_x(fal_get_str_len(FAL_LABEL[0]),   OLED_FONT_MEDIUM_WIDTH), 26, OLED_FONT_MEDIUM, OLED_WHITE, FAL_LABEL[0]);
    print(fal_center_x(fal_get_str_len(FAL_VERSION[0]), OLED_FONT_SMALL_WIDTH),  50, OLED_FONT_SMALL,  OLED_WHITE, FAL_VERSION[0]);
}

