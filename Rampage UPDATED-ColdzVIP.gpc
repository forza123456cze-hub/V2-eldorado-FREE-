define BITS_IN_INT = 32;			// Number of bits in a GPC int (32 bits)
define MAX_BIT_POSITION = 31;		// Highest allowable bit to bet set not including a sign
define SCREENSAVER_TIME = 10000;	// Set the default screen saver time to 10000ms (10 seconds)
define VERSION_MAJOR = 1;			// Version major
define VERSION_MINOR = 2;			// Version minor

int assist[9];		// Assist variables
