int cycleRunTime,stepInterval = 6,maxColourChange,colorChange;
combo rgb {
    cycleRunTime += get_rtime();
	if(!(cycleRunTime++ % stepInterval)){ 
		if(!maxColourChange){ 
			colorChange     -= 1; 
			if(colorChange < 0) 
				maxColourChange = TRUE;
		}
		else { 
			colorChange     += 1;
			if(colorChange > 359) 
				maxColourChange = FALSE;
		}
		cycleRunTime = 0;  
	} 
	set_hsb(colorChange,70,70);
}
