const uint8 MenuButtons [] = {  
  PS4_RIGHT ,
  PS4_LEFT , 
  PS4_UP , 
  PS4_DOWN , 
  PS4_CROSS , 
  PS4_CIRCLE , 
  PS4_OPTIONS , 
  PS4_L2    
}; 

int menu_btn_indx;
int MenuTimeOut;
define menu_time_active = 30000;
function CheckIfBtnIsPressed (){  
    for(menu_btn_indx = 0; menu_btn_indx < 7; menu_btn_indx++){
         if(event_press(MenuButtons[menu_btn_indx]) ){
             MenuTimeOut = menu_time_active;
         }
         if(MenuTimeOut){              
            MenuTimeOut -=1;
            if(MenuTimeOut <= 0 ){    
                ModMenu = FALSE;      
                ModEdit = FALSE;      
                display_EDIT  = FALSE;  
            }
        }
    }
}

int ls_X,ls_Y,curve_sign,rs_X,rs_Y;
main{
if(ls_X < 0){
	curve_sign = 1;
	ls_X = left_stick_curve[abs(ls_X)]	
	set_val(TRACE_1, ls_X);}

	if(curve_sign){
	ls_X = inv(ls_X);
	curve_sign = 0;}

	if(ls_Y < 0){
	curve_sign = 1;
	ls_Y = left_stick_curve[abs(ls_Y)]}
	
	
	  if(rs_X < 0){
	curve_sign = 1;
	rs_X = right_stick_curve[abs(rs_X)]	
	set_val(TRACE_1, rs_X);}

	if(curve_sign){
	rs_X = inv(rs_X);
	curve_sign = 0;}

	if(rs_Y < 0){
	curve_sign = 1;
	rs_Y = right_stick_curve[abs(rs_Y)]
	}
}
