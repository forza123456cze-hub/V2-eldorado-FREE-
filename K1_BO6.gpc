function RemoveStickNoise() {

  if(isqrt(pow(abs(get_ival(PS4_LX)),2) + pow(abs(get_ival(moveLY)),2)) <= DeadZoneSize) {
    set_val(PS4_LX,0);
    set_val(moveLY,0);
  }

  if(isqrt(pow(abs(get_ival(aim_x)),2) + pow(abs(get_ival(aim_y)),2)) <= DeadZoneSize) {
    set_val(aim_x,0);
    set_val(aim_y,0);
  }
}

