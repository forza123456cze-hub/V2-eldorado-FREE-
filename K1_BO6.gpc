function offset(Stick,Value) {
  set_val(Stick, clamp(Value * (100 - abs(get_val(Stick))) / 100 + get_val(Stick), -100, 100));
  return;
}
function offset_sticky_ar(Stick,Value) {
set_val(Stick, clamp(Value * (100 - abs(get_ival(Stick))) / 100 + get_ival(Stick), -100, 100));return;
}
function set_Ival(Input,Output) {

      set_val(Input,clamp(Output * (100 - abs(get_val(Input))) / 100 + get_val(Input),-100,100));
        
      return; 
}
function getPolar(Stick, AngleOrRadius) {
  if (AngleOrRadius) return get_polar(Stick, POLAR_ANGLE);
  return isqrt((get_val(Stick + 42) * get_val(Stick + 42)) + (get_val(Stick + 43) * get_val(Stick + 43)));   
}
function print_progress_bar( val, max_val) {
	rect_oled(13, 50, ((val * 100) / max_val), 8, 1, 1);
	
}
int normalized_value, interpolated_value, ret_Interpolate; 

function Interpolate(int value, int max_value, int exponent)
{
    if(value != 0)
    {
	    normalized_value = fix16_sdiv(abs(value), max_value);
	    ret_Interpolate = fix16_log(normalized_value);
	    ret_Interpolate = fix16_smul(ret_Interpolate , exponent);
	    ret_Interpolate = fix16_exp(ret_Interpolate);
	    interpolated_value = fix16_smul(ret_Interpolate, max_value);
		interpolated_value =  clamp(interpolated_value, 0, Fix16MaxJoystick);
		
		if(value < 0)
			interpolated_value = inv(interpolated_value);
	}
	else
	{
		interpolated_value = 0;
	}
	
    return interpolated_value;
}
int neg_exp;
int result_exp;
int term_exp;
int i_exp;

function fix16_exp(int inValue)
{
  if (inValue == 0)
    return fix16_one;
  if (inValue == fix16_one)
    return fix16_e;
  if (inValue >= 681391)
    return fix16_maximum;
  if (inValue <= -772243)
    return 0;

  if(inValue < 0)
  	neg_exp = 1;
  else
  	neg_exp = 0;
  	
  if (neg_exp)
    inValue = -inValue;

  result_exp = inValue + fix16_one;
  term_exp = inValue;

  for (i_exp = 2; i_exp < 30; i_exp++)
  {
    term_exp = fix16_mul(term_exp, fix16_div(inValue, fix16_from_int(i_exp)));
    result_exp = result_exp + term_exp;

    if ((term_exp < 500) && ((i_exp > 15) || (term_exp < 20)))
    {
    	i_exp = 100;
    }
  }

  if (neg_exp)
    result_exp = fix16_div(fix16_one, result_exp);

  return result_exp;
}
int remainder_div;
int divider_div;
int quotient_div;
int bit_div;
int result_div;

function fix16_div(int a, int b)
{
  

  if (b == 0)
    return fix16_minimum;

  if(a >= 0)
  {
  	remainder_div = a;
  }
  else
  {
  	remainder_div = -a;
  }
  
  if(b >= 0)
  {
  	divider_div = b;
  }
  else
  {
  	divider_div = -b;
  }

  quotient_div = 0;
  bit_div = 0x10000;

  
  while (divider_div < remainder_div)
  {
    divider_div = divider_div<<1;
    bit_div = bit_div<<1;
  }

  if (!bit_div)
    return fix16_overflow;

  if (divider_div & 0x80000000)
  {
   
    if (remainder_div >= divider_div)
    {
      quotient_div = quotient_div | bit_div;
      remainder_div = remainder_div - divider_div;
    }
    divider_div = divider_div>>1;
    bit_div = bit_div>>1;
  }

 
  while (bit_div && remainder_div)
  {
    if (remainder_div >= divider_div)
    {
      quotient_div = quotient_div | bit_div;
      remainder_div = remainder_div - divider_div;
    }

    remainder_div = remainder_div<<1;
    bit_div = bit_div>>1;
  }

  result_div = quotient_div;

  
  if ((a ^ b) & 0x80000000)
  {

    if (result_div == fix16_minimum)
      return fix16_overflow;

    result_div = -result_div;
  }

  return result_div;
}
int a_mul;
int b_mul;
int v_a0_mul, v_a1_mul, v_a2_mul, v_a3_mul;
int v_b0_mul, v_b1_mul, v_b2_mul, v_b3_mul;
int low_mul;
int mid_mul;
int result_mul;

function fix16_mul(int inArg0, int inArg1)
{
	if(inArg0 >= 0)
	{
		a_mul = inArg0;
	}
	else
	{
		a_mul = -inArg0;
	}

	if(inArg1 >= 0)
	{
		b_mul = inArg1;
	}
	else
	{
		b_mul = -inArg1;
	}
	
	v_a0_mul = 0x000000FF & a_mul;
	v_a1_mul = 0x000000FF & (a_mul >> 8);
	v_a2_mul = 0x000000FF & (a_mul >> 16);
	v_a3_mul = 0x000000FF & (a_mul >> 24);
	
	v_b0_mul = 0x000000FF & b_mul;
	v_b1_mul = 0x000000FF & (b_mul >> 8);
	v_b2_mul = 0x000000FF & (b_mul >> 16);
	v_b3_mul = 0x000000FF & (b_mul >> 24);
	

	  
	low_mul = 0;
	mid_mul = 0;
	
	


	
	if (v_a3_mul != 0 && v_b3_mul !=0 ) return fix16_overflow;

	
	
	if (v_a2_mul && v_b3_mul) mid_mul = mid_mul + ((v_a2_mul * v_b3_mul) & 0x0000FFFF);
	if (v_a3_mul && v_b2_mul) mid_mul = mid_mul + ((v_a3_mul * v_b2_mul) & 0x0000FFFF);
	mid_mul = mid_mul<<8;
	
	
	
	
	if (v_a1_mul && v_b3_mul) mid_mul = mid_mul + ((v_a1_mul * v_b3_mul) & 0x0000FFFF);
	if (v_a2_mul && v_b2_mul) mid_mul = mid_mul + ((v_a2_mul * v_b2_mul) & 0x0000FFFF);
	if (v_a3_mul && v_b1_mul) mid_mul = mid_mul + ((v_a3_mul * v_b1_mul) & 0x0000FFFF);
	

	if (mid_mul & 0xFF000000) return fix16_overflow;

	mid_mul = mid_mul<<8;
	
	
	if (v_a0_mul && v_b3_mul) mid_mul = mid_mul + ((v_a0_mul * v_b3_mul) & 0x0000FFFF);
	if (v_a1_mul && v_b2_mul) mid_mul = mid_mul + ((v_a1_mul * v_b2_mul) & 0x0000FFFF);
	if (v_a2_mul && v_b1_mul) mid_mul = mid_mul + ((v_a2_mul * v_b1_mul) & 0x0000FFFF);
	if (v_a3_mul && v_b0_mul) mid_mul = mid_mul + ((v_a3_mul * v_b0_mul) & 0x0000FFFF);
	

	if (mid_mul & 0xFF000000) return fix16_overflow;

	mid_mul = mid_mul<<8;
	
	
	if (v_a0_mul && v_b2_mul) mid_mul = mid_mul + ((v_a0_mul * v_b2_mul) & 0x0000FFFF);
	if (v_a1_mul && v_b1_mul) mid_mul = mid_mul + ((v_a1_mul * v_b1_mul) & 0x0000FFFF);
	if (v_a2_mul && v_b0_mul) mid_mul = mid_mul + ((v_a2_mul * v_b0_mul) & 0x0000FFFF);		
	
	
	if (v_a0_mul && v_b1_mul) low_mul = low_mul + ((v_a0_mul * v_b1_mul) & 0x0000FFFF);
	if (v_a1_mul && v_b0_mul) low_mul = low_mul + ((v_a1_mul * v_b0_mul) & 0x0000FFFF);
	low_mul = low_mul<<8;
	
	
	if (v_a0_mul && v_b0_mul) low_mul = low_mul + ((v_a0_mul * v_b0_mul) & 0x0000FFFF);
	

	mid_mul = mid_mul + (low_mul >> 16);
	

	if (mid_mul & 0x80000000)
		return fix16_overflow;

	
	result_mul = mid_mul;
	
	
	if ((inArg0 >= 0) != (inArg1 >= 0))
	{
		result_mul = -result_mul;
	}
	
	return result_mul;
}
function fix16_log(int x_log) 
{
    return fix16_sdiv(fix16_ln(x_log), fix16_ln(fix16_from_int(10))) ;
}
int guess_exp 
int delta_exp;
int scaling_exp;
int count_exp;
int e_exp;
int e_to_fourth = 3578144;

function fix16_ln(int inValue)
{
  guess_exp = fix16_from_int(2);
  delta_exp = 0;
  scaling_exp = 0;
  count_exp = 0;

  if (inValue <= 0)
    return fix16_minimum;

  
  e_to_fourth = 3578144;
  while (inValue > fix16_from_int(100))
  {
    inValue = fix16_div(inValue, e_to_fourth);
    scaling_exp = scaling_exp + 4;
  }

  while (inValue < fix16_one)
  {
    inValue = fix16_mul(inValue, e_to_fourth);
    scaling_exp = scaling_exp - 4;
  }

  do
  {
    
    e_exp = fix16_exp(guess_exp);
    delta_exp = fix16_div(inValue - e_exp, e_exp);

    
    if (delta_exp > fix16_from_int(3))
      delta_exp = fix16_from_int(3);

    guess_exp = guess_exp + delta_exp;
  } while ((count_exp++ < 10) && ((delta_exp > 1) || (delta_exp < -1)));

  return guess_exp + fix16_from_int(scaling_exp);
}
int result_smul;

function fix16_smul(int inArg0, int inArg1)
{
  result_smul = fix16_mul(inArg0, inArg1);

  if (result_smul == fix16_overflow)
  {
    if ((inArg0 >= 0) == (inArg1 >= 0))
      return fix16_maximum;
    else
      return fix16_minimum;
  }

  return result_smul;
}
int result_sdiv;
function fix16_sdiv(int inArg0, int inArg1)
{
  result_sdiv = fix16_div(inArg0, inArg1);

  if (result_sdiv == fix16_overflow)
  {
    if ((inArg0 >= 0) == (inArg1 >= 0))
      return fix16_maximum;
    else
      return fix16_minimum;
  }

  return result_sdiv;
}
function fix16_into_int(int a)
{
  return (a >> 16);
}
int fix_result_float;
int fix_float_sign;
function fix16_from_float(int integer_part, int fractional_part)
{
     if(integer_part < 0)
     	fix_float_sign = -1;
     else
     	fix_float_sign = 1;
     
     fix_result_float = fix16_from_int(abs(integer_part))
        + fix16_sdiv(fix16_from_int(clamp(fractional_part, 0, 1000)), fix16_1000);
    return fix_result_float * fix_float_sign;
} 
