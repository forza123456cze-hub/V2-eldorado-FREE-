	cls_oled(0);   
	display_title  = FALSE;           
}
int data_indx;
function colourled(color) {  
    for( data_indx = 0; data_indx < 3; data_indx++ ) {
        set_led(data_indx,duint8 ((color * 3) + data_indx));
    }
}

 function printText(x, y, text, size, color) {
	insertString(text);
	flushBuffer(x, y, size, color);
}
function insertString(s) {
	
    do {
    	insertCharacter(dint8(s));
    	s++;
    } while(dint8(s)) 
}
int displayBuffer;
function flushBuffer(x, y, size, color) {
	
	displayBuffer--; 
	
	
	switch(x) { 
		case alignRight {
			x = OLED_WIDTH - (displayBuffer * fontWidth[size]) - 4;
			break;	
		} case alignCenter {
			x = (OLED_WIDTH >> 1) - ((displayBuffer * fontWidth[size]) >> 1);
			break;
		}
		
	}
	
	
	switch(y) { 
		case alignCenter {
			y = (OLED_HEIGHT >> 1) - (fontHeight[size] >> 1);
			break;
		} case alignBottom {
			y = OLED_HEIGHT - fontHeight[size] - 4; 
			break;	
		}
		
	}
	
	puts_oled(x, y, size, displayBuffer, color); 
	displayBuffer = 1; 
}
function insertCharacter(int value) {
	putc_oled(displayBuffer, value);
	displayBuffer++;
}
function adjustSensitivity(sensitivityIndex) {
    
    switch (sensitivityIndex) {
        case 0: {
            sensitivityAdjustments[0] = ANARCHY0s776; 
            sensitivityAdjustments[1] = 0;
            break;
        }
        case 1: {
            sensitivityAdjustments[0] = -ANARCHY0s776; 
            sensitivityAdjustments[1] = 0;
            break;
        }
        case 2: {
            sensitivityAdjustments[0] = 0; 
            sensitivityAdjustments[1] = ANARCHY0s776;
            break;
        }
        case 3: {
            sensitivityAdjustments[0] = 0; 
            sensitivityAdjustments[1] = -ANARCHY0s776;
            break;
        }
        case 4: {
            sensitivityAdjustments[0] = -ANARCHY0s776; 
            sensitivityAdjustments[1] = 0;
            break;
        }
        case 5: {
            sensitivityAdjustments[0] = ANARCHY0s776; 
            sensitivityAdjustments[1] = 0;
            break;
        }
        case 6: {
            sensitivityAdjustments[0] = 0; 
            sensitivityAdjustments[1] = -ANARCHY0s776;
            break;
        }
        case 7: {
            sensitivityAdjustments[0] = 0; 
            sensitivityAdjustments[1] = ANARCHY0s776;
            break;
        }
    }
}

function polarRS(Stick) {
  return isqrt((get_val(Stick + 42) * get_val(Stick + 42)) + (get_val(Stick + 43) * get_val(Stick + 43)));
}
function customPolarSens(fId,fMid,fIndex) {
	fValue = get_val(fId);
    if(fMid != NOT_USE) {
    	fValueSens = -1;
    	if(fValue >= 0) fValueSens = 1;
        	fValue *= fValueSens;
        if(fValue <= fMid) 
        	fValue = (fValue * 16384) / fMid;
        else 
        	fValue = ((16384 * (fValue - fMid)) / (32767 - fMid)) + 16384;
        	fValue *= fValueSens;
    }
    if(fIndex != NOT_USE) {
        fValue = (fValue * fIndex) / 32767;
    }
    set_val(fId,clamp(fValue,-32768,32767));
    return;
}
