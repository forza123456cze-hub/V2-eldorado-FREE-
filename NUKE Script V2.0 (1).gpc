function Save() {
PVALData = PackInt8ToInt16(OmniARVert,OmniARHoriz);    
set_pvar(SPVAR_1,PVALData); 
PVALData = PackInt8ToInt16(VerticalStart,VerticalEnd);    
set_pvar(SPVAR_2,PVALData); 
