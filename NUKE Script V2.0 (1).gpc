offset(PS4_LY, X);
wait(OmniABoostSpd * 8);
offset(PS4_LY, X);
offset(PS4_LX, 25);
wait(OmniABoostSpd * 10);
offset(PS4_LX, inv(27));
offset(PS4_LY, X);
wait(OmniABoostSpd * 8);
}
