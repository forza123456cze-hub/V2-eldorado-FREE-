const int16 taylorShapeCeorinInfo[][] = { 
{      0    ,    0     ,    0     ,          1         ,         1          ,     1 }, // Helix
{      1    ,    0     ,    0     ,          1         ,         0          ,     0 }, // Kitt 
{      2    ,    0     ,    0     ,          0         ,         1          ,     0 }, // Vertical Flare
