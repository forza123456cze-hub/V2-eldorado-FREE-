int timer;

function GetShapesV1(f_var) {     
   
    if(!SpiralPosition1)                                
	{
		InnerSpiral -= 1;
		if(InnerSpiral < 1)
			SpiralPosition1 = TRUE;
	}
	else
	{
	    InnerSpiral += 1;
		if(InnerSpiral > f_var)
			SpiralPosition1 = FALSE;
	}
	if(!SpiralPosition2)
	{
		OuterSpiral -= 1;
		if(OuterSpiral < 1)
			SpiralPosition2 = TRUE;
	}
	else
	{
		OuterSpiral += 1;
		if(OuterSpiral >  f_var)
			SpiralPosition2 = FALSE;
	} 
	if(toggle_aimassist[profile_idx] == 2)                    
	{ 
        RY = (sin_angle * f_var) /100;
        RX = (cos_angle * f_var) /100;  
	} 
	if(toggle_aimassist[profile_idx] == 3)        
	{ 
        RY = (sin_angle * f_var) /100;
        RX = (cos_angle * (f_var / 2)) /100; 
	}
	if(toggle_aimassist[profile_idx] == 4)                     
	{ 
        RY = (sin_angle * (f_var / 2)) /100;
        RX = (cos_angle * f_var) /100;  
	} 
	if(toggle_aimassist[profile_idx] == 5)                  
	{
        RY = (sin_angle * InnerSpiral) /100;
        RX = (cos_angle * OuterSpiral) /100;  
	}
    if(toggle_aimassist[profile_idx] == 6)
	{
		RX = (cos_angle * Position) /100;
		RY = (sin_angle * Position) /100;
	
		if(Position == 0)
		    RX = (cos_angle * f_var) /100;
		    
		if(Position == 1)
			RY = (sin_angle * f_var) /100;
			
		if(Position == 2) 
			RX = (cos_angle * f_var) /100 * -1;
			
		if(Position == 3)
			RY = (sin_angle * f_var) /100 * -1;
			
		timer++;
		if(timer >= aimassist_angle)
		{
			Position++;
			timer = 0;
		}
				
		if(Position == 4)
			Position = 0;
    }
    
    if(toggle_aimassist[profile_idx] == 11){
	if(solution2==1) counter = duint8(0);
	if(solution2==-1) counter = inv(duint8(0));
	if(solution2 >=2) counter = dig*7+duint8(0);
	if(solution2 <=-2) counter = dig*7+inv(duint8(0));
	if(solution2 >=2) dig = solution2 - 1
	if(solution2 <=-2) dig = solution2 + 1
	if(solution3==1) counter2 = duint8(1);
	if(solution3==-1) counter2 = inv(duint8(1));
	if(solution3 >=2) counter2 = dig2*6+duint8(1);
	if(solution3 <=-2) counter2 = dig2*6+inv(duint8(1));
	if(solution3 >=2) dig2 = solution3 - 1
	if(solution3 <=-2) dig2 = solution3 + 1

	super = get_lval(PS4_ACCY);
	if(event_press(PS4_L2)) indx=get_lval(PS4_ACCY);
	if(super == indx) set_val(PS4_RY, 0);
	if(get_val(PS4_L2)) solution2=behav(indx, super);
	if(freeman <= 9) freeman=demon(super2, indx2);
	if(freeman2 > 9) freeman2= 9
	if(freeman > 9) freeman= 9
	if(counter2 < 0 && freeman2 <= 0) deal = counter2-freeman2*2
	if(counter2 < 0 && freeman2 >= 0) deal = counter2+freeman2*2
	if(counter2 > 0 && freeman2 >= 0) deal = counter2-freeman2*2
	if(counter2 > 0 && freeman2 <= 0) deal = counter2+freeman2*2
	if(counter < 0 && freeman <= 0) deal2 = counter-freeman*2
	if(counter < 0 && freeman >= 0) deal2 = counter+freeman*2
	if(counter > 0 && freeman >= 0) deal2 = counter-freeman*2
	if(counter > 0 && freeman <= 0) deal2 = counter+freeman*2
	super2 = get_lval(PS4_ACCX);
	if(event_press(PS4_L2)) indx2=get_lval(PS4_ACCX);
	if(super2 == indx2) set_val(PS4_RX, 0);
	if(get_val(PS4_L2)) solution3=behav2(indx2, super2);
	if(freeman2 <= 9) freeman2=demon(super, indx);

		set_val(PS4_ACCX, 0);
		set_val(PS4_ACCY, 0);
		set_val(PS4_RX, 0);
		set_val(PS4_RY, 0);

	if(get_lval(PS4_RY) > 20 || get_lval(PS4_RY) < -20) set_val(PS4_RY, get_lval(PS4_RY));
	if(get_lval(PS4_RX) > 20 || get_lval(PS4_RX) < -20) set_val(PS4_RX, get_lval(PS4_RX));


	if(deal2 >= 100 && get_val(PS4_R2)) set_val(PS4_RY, 100);
	if(get_val(PS4_L2) && !(super == indx)) {if(get_val(PS4_RY) < 20 && get_val(PS4_RY) > -20) set_val(PS4_RY, deal2);}
	if(deal2 <= -100 && get_val(PS4_L2)) set_val(PS4_RY, -100);
	if(deal >= 100 && get_val(PS4_L2)) set_val(PS4_RX, 100);
	if(get_val(PS4_L2)&& !(super2 == indx2)) {if(get_val(PS4_RX) < 20 && get_val(PS4_RX) > -20) set_val(PS4_RX, deal);}
	if(deal <= -100 && get_val(PS4_L2)) set_val(PS4_RX, -100);}

	cos_angle = RX;
	sin_angle = RY;
}

function demon(a, b) {
     return (a) - (b);
}

function behav(a, b) {
     return (a) + (b);
}

function behav2(a, b) {
     return (a) - (b);
}  

int __pictureX, __pictureX2, __pictureY, __pictureY2, __pictureBit, __pictureOffset, __pictureData;
function draw_picture(x, y, invert) {
	__pictureOffset = 2; // Reset the starting point
	__pictureBit = 16; // Reset bit flag
	for (__pictureY = 0; __pictureY < logo[1]; __pictureY++) { // Loop the Y axis
		for (__pictureX = 0; __pictureX < logo[0]; __pictureX++) { // Loop the X axis
			__pictureData = logo[__pictureOffset]
			__pictureX2 = x + __pictureX;
			__pictureY2 = y + __pictureY;
			if (__pictureX2 < 0 || __pictureX2 >= 128) {
				__pictureX2 -= 128;
			}
			if (__pictureY2 < 0 || __pictureY2 >= 64) {
				__pictureY2 -= 64;
			}
			if (test_bit(__pictureData, __pictureBit - 1)) {
				pixel_oled(__pictureX2, __pictureY2, !invert);
			}
			else {
				pixel_oled(__pictureX2, __pictureY2, invert);
			}
			__pictureBit--; // Decrement the bit flag, we're moving to the next bit
			if (!__pictureBit) { // Check if we've just handled the last bit
				__pictureBit = 16; // Reset the bit flag
				__pictureOffset++; // Move to the next value
			}
		}
	}
} 

