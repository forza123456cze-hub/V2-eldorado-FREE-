            if ((rapidfire_onoff == 2 && get_ival(BTN_AIM) && get_ival(BTN_FIRE)) || (rapidfire_onoff == 1 && get_ival(BTN_FIRE) && !get_ival(BTN_AIM)) || (rapidfire_onoff == 3 && get_ival(BTN_FIRE))) {
                 combo_run(RAPID_FIRE_cmb);         
            }                                       
            ///////////////////////////////////////// 
        }
            } //  end of MODS CODE 
    } //  ENTIRE SCRIPT KILL SWITCH 
} //  end of main block 
