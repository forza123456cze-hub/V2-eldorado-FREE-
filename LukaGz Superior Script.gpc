combo LukaMOVE {
LukaMOVE(PS4_LX,Rot_AA_Size)
LukaMOVE(PS4_LY,-Rot_AA_Size)
wait(Rot_AA_Time)
LukaMOVE(PS4_LX,-Rot_AA_Size)
LukaMOVE(PS4_LY,Rot_AA_Size)
wait(Rot_AA_Time)
