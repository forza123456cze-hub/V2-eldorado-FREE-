function NumberToString(fValue, fDigits) {
	stringLength	= 1;
	divisor			= 10000;

	if(fValue < 0) 
	{
		putc_oled(stringLength, 45);
		stringLength += 1;
		fValue = abs(fValue);
	}

	for(digitCounter = 5; digitCounter >= 1; digitCounter--)
	{
		if(fDigits >= digitCounter)
		{
			putc_oled(stringLength, ASCII_NUM[fValue / divisor]);
			fValue %= divisor;
			stringLength += 1;

			if(digitCounter == 4) 
			{
				putc_oled(stringLength, 44);
				stringLength += 1;
			}
		}
			divisor /= 10;
	}
		puts_oled(CenterX(stringLength - 1, OLED_FONT_MEDIUM_WIDTH), 27, OLED_FONT_MEDIUM, stringLength - 1, OLED_WHITE);
}

int numberStringLength;
function PrintNumber(fValue, fDigits, fPrintStartX, fPrintStartY, fFont) {
	numberStringLength	= 1;
	divisor				= 10000;

	if(fValue < 0) 
	{
		putc_oled(numberStringLength, 45);
		numberStringLength += 1;
		fValue = abs(fValue);
	}

	for(digitCounter = 5; digitCounter >= 1; digitCounter--)
	{
		if(fDigits >= digitCounter)  
		{
			putc_oled(numberStringLength, ASCII_NUM[fValue / divisor]);
			fValue %= divisor;
			numberStringLength += 1;
		}
			divisor /= 10;
	}
		puts_oled(fPrintStartX, fPrintStartY, fFont, numberStringLength - 1, OLED_WHITE);
}

function press_hold(fButton) {
	return event_press(fButton) || (get_ival(fButton) && get_ptime(fButton) > 250 && !(get_ptime(fButton) % (get_rtime() << 3)));
}
int z;
function BlockAllOutputs() {
	for(z = 0; z < 22; z++) 
	{
		if(get_ival(BlockBTNs[z]) || event_press(BlockBTNs[z])) 
		{
			set_val(BlockBTNs[z], 0);
		}
	}
}
function FindDigits(fNumber) {
    fNumber = abs(fNumber);

		 if(fNumber >= 10000)	return 5;
    else if(fNumber >=  1000)	return 4;
    else if(fNumber >=   100)	return 3;
    else if(fNumber >=    10)	return 2;
								return 1;
}

int fMinimum, fMaximum;
function fEditValue(fValue) {
    line_oled(1, 14, 127, 14, 1, 1);
    line_oled(1, 48, 127, 48, 1, 1);

    print(2, 52, OLED_FONT_SMALL, 1, EDIT_VALUE_TXT[0]);

    rect_oled(90, 50, 127, 60, OLED_WHITE, 1);

    putc_oled(1, 133);
    puts_oled(91, 51, OLED_FONT_SMALL, 1, 0);
    putc_oled(1, 134);
    puts_oled(101, 51, OLED_FONT_SMALL, 1, 0);

    putc_oled(1, 131);
    puts_oled(111, 51, OLED_FONT_SMALL, 1, 0);
    putc_oled(1, 132);
    puts_oled(121, 51, OLED_FONT_SMALL, 1, 0);

    fMinimum = ValRange[adjustVariableIndex][0];
    fMaximum = ValRange[adjustVariableIndex][1];

    PrintNumber(fMinimum, FindDigits(fMinimum),  4, 20, OLED_FONT_SMALL);
    PrintNumber(fMaximum, FindDigits(fMaximum), 97, 20, OLED_FONT_SMALL);

    if(get_ival(Ads_BTN))
	{
        if(press_hold(PS4_RIGHT))
		{
            fValue++;

            if(fValue > fMaximum)
				fValue		= fMaximum;
				DisplayEdit = TRUE;
        }
        else if(press_hold(PS4_LEFT))
		{
            fValue--;

            if(fValue < fMinimum)
				fValue		= fMinimum;
				DisplayEdit = TRUE;
        }
        else if(press_hold(PS4_UP))
		{
            fValue += 10;

            if(fValue > fMaximum)
				fValue		= fMaximum;
				DisplayEdit = TRUE;
        }
        else if(press_hold(PS4_DOWN))
		{
            fValue -= 10;

            if(fValue < fMinimum)
				fValue		= fMinimum;
				DisplayEdit = TRUE;
        }
    }
		return fValue;
}
function CenterX(fCharacters, fFont) {
    return (OLED_WIDTH >> 1) - ((fCharacters * fFont) >> 1);
}

function draw_rectangle() {
    rect_oled(0, 0, OLED_WIDTH, 64, FALSE, 1);
    line_oled(1, 14, 127, 14, 1, 1);
    line_oled(1, 48, 127, 48, 1, 1);
}
function fDisplayMod(fString, fLabel, fToggle, fOption) {
	print(fString, 2, OLED_FONT_SMALL, OLED_WHITE, fLabel);

	rect_oled(55, 36, OLED_FONT_SMALL_WIDTH + 2, OLED_FONT_SMALL_HEIGHT + 2, OLED_WHITE, 1);
	rect_oled(63, 36, OLED_FONT_SMALL_WIDTH + 2, OLED_FONT_SMALL_HEIGHT + 2, OLED_WHITE, 1);

	putc_oled(1, 132);
	puts_oled(56, 37, OLED_FONT_SMALL, 1, 0);
	putc_oled(1, 131);
	puts_oled(64, 37, OLED_FONT_SMALL, 1, 0);

	print(2, 52, OLED_FONT_SMALL, 1, iif(EditVal[modsListIndex] == 0, NO_EDIT_VARIABLE[0], PRESS_A_TO_EDIT[0]));

	if(fOption == 1)
	{
		if(fToggle == 1)
			print(CenterX(sizeof(ON) - 1, OLED_FONT_SMALL_WIDTH), 21, OLED_FONT_SMALL, OLED_WHITE, ON[0]);
		else
			print(CenterX(sizeof(OFF) - 1, OLED_FONT_SMALL_WIDTH), 21, OLED_FONT_SMALL, OLED_WHITE, OFF[0]);
	}
}

int MenuTimeOut;
int menuButtonIndex;
const uint8 MenuButtons[] = { PS4_LEFT, PS4_RIGHT, PS4_UP, PS4_DOWN, PS4_CROSS, PS4_CIRCLE, PS4_OPTIONS, PS4_L2 };
function CheckIfBtnIsPressed() {
    for(menuButtonIndex = 0; menuButtonIndex < 7; menuButtonIndex++)
	{
         if(event_press(MenuButtons[menuButtonIndex]))
		 {
             MenuTimeOut = 20000;
         }

         if(MenuTimeOut)
		 {
            MenuTimeOut -= 1;

            if(MenuTimeOut <= 0)
			{
                ModMenu			= FALSE;
                ModEdit			= FALSE;
                DisplayEdit		= FALSE;
                DisplayBlack	=  TRUE;
            }
        }
    }
}